---
const { title, author, description, language, href } = Astro.props;
---

<a class="book-card" href={href}>

    <div class="card-top">
        <div class="card-info">
            <h3>{title}</h3>
            <p class="author">{author}</p>
        </div>
        {language && (
            <span class:list={["lang-badge", language === "فارسی" ? "fa" : "ar"]}>
                {language}
            </span>
        )}
    </div>

    {description && (
        <details class="accordion">
            <summary>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            </summary>
            <p class="desc">{description}</p>
        </details>
    )}

</a>

<style lang="scss">

.book-card{
display:block;
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
text-decoration:none;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}
}

.card-top{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px;
}

.card-info{
flex:1;
min-width:0;

h3{
font-size:17px;
margin-bottom:6px;
}
}

.author{
color:var(--accent);
font-size:13px;
margin-bottom:0;
}

.lang-badge{
flex-shrink:0;
font-size:11px;
font-weight:700;
padding:4px 10px;
border-radius:20px;
white-space:nowrap;
}

.lang-badge.fa{
background:color-mix(in srgb, #2b9348 18%, transparent);
color:#2b9348;
}

.lang-badge.ar{
background:color-mix(in srgb, #e07b39 18%, transparent);
color:#e07b39;
}

:global(.dark) .lang-badge.fa{
background:color-mix(in srgb, #4ade80 18%, transparent);
color:#4ade80;
}

:global(.dark) .lang-badge.ar{
background:color-mix(in srgb, #fb923c 18%, transparent);
color:#fb923c;
}

.accordion{
margin-top:4px;

summary{
display:flex;
align-items:center;
justify-content:flex-end;
cursor:pointer;
padding:2px 0;
list-style:none;
color:var(--gray);
transition:color .2s;

&::before{
display:none;
}

&::-webkit-details-marker{
display:none;
}

&:hover{
color:var(--accent);
}
}

&[open] summary{
color:var(--accent);
margin-bottom:6px;

svg{
transform:rotate(180deg);
}
}

svg{
transition:transform .3s ease;
}
}

.desc{
color:var(--gray);
font-size:13px;
line-height:1.8;
margin:0;
}

</style>
