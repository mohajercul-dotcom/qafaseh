---
const { title, author, description, publisher, year, language, href } = Astro.props;
---

<a class="book-card" href={href}>

    <div class="card-top">
        <div class="card-info">
            <h3>{title}</h3>
            <p class="author">{author}</p>
        </div>
        {language && (
            <span class:list={["lang-badge", language === "فارسی" ? "fa" : "ar"]}>
                {language}
            </span>
        )}
    </div>

    {description && (
        <details class="accordion">
            <summary>توضیحات</summary>
            <p class="desc">{description}</p>
        </details>
    )}

    <div class="meta">
        {publisher && <span>{publisher}</span>}
        {year && <span>{year}</span>}
    </div>

</a>

<style lang="scss">

.book-card{
display:block;
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
text-decoration:none;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}
}

.card-top{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px;
}

.card-info{
flex:1;
min-width:0;

h3{
font-size:17px;
margin-bottom:6px;
}
}

.author{
color:var(--accent);
font-size:13px;
margin-bottom:0;
}

.lang-badge{
flex-shrink:0;
font-size:11px;
font-weight:700;
padding:4px 10px;
border-radius:20px;
white-space:nowrap;
}

.lang-badge.fa{
background:color-mix(in srgb, #2b9348 18%, transparent);
color:#2b9348;
}

.lang-badge.ar{
background:color-mix(in srgb, #e07b39 18%, transparent);
color:#e07b39;
}

:global(.dark) .lang-badge.fa{
background:color-mix(in srgb, #4ade80 18%, transparent);
color:#4ade80;
}

:global(.dark) .lang-badge.ar{
background:color-mix(in srgb, #fb923c 18%, transparent);
color:#fb923c;
}

.accordion{
margin-top:12px;

summary{
font-size:13px;
color:var(--gray);
cursor:pointer;
padding:6px 0;
list-style:none;

&::before{
content:"▸ ";
}

&::-webkit-details-marker{
display:none;
}
}

&[open] summary{
color:var(--accent);
margin-bottom:6px;

&::before{
content:"▾ ";
}
}
}

.desc{
color:var(--gray);
font-size:13px;
line-height:1.8;
margin:0;
}

.meta{
display:flex;
justify-content:space-between;
color:var(--gray);
font-size:12px;
border-top:1px solid var(--border);
padding-top:12px;
margin-top:12px;
}

</style>
