---
const { title, author, description, publisher, year, language, href } = Astro.props;
---

<div class="book-card" data-accordion>

    <div class="card-main">

        <div class="card-info">
            <h3>{title}</h3>
            <p class="author">{author}</p>
        </div>

        <div class="card-right">
            {language && (
                <span class:list={["lang-badge", language === "فارسی" ? "fa" : "ar"]}>
                    {language}
                </span>
            )}
            {description && (
                <svg class="chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 12 15 18 9"/></svg>
            )}
        </div>

    </div>

    {description && (
        <div class="accordion-body">
            <p class="desc">{description}</p>
            <div class="desc-row">
                <a class="more-btn" href={href}>بیشتر</a>
            </div>
            <div class="meta-line">
                <span class="year">{year}</span>
            </div>
        </div>
    )}

</div>

<script>
document.querySelectorAll("[data-accordion]").forEach((card) => {
    card.addEventListener("click", () => {
        const body = card.querySelector(".accordion-body");
        if (!body) return;

        const isOpen = card.classList.contains("open");

        document.querySelectorAll("[data-accordion].open").forEach((other) => {
            if (other !== card) {
                other.classList.remove("open");
                other.querySelector(".accordion-body").style.maxHeight = "0";
            }
        });

        if (isOpen) {
            card.classList.remove("open");
            body.style.maxHeight = "0";
        } else {
            card.classList.add("open");
            body.style.maxHeight = body.scrollHeight + "px";
        }
    });
});
</script>

<style lang="scss">

.book-card{
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
cursor:pointer;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}
}

.card-main{
display:flex;
justify-content:space-between;
align-items:flex-start;
gap:10px;
}

.card-info{
flex:1;
min-width:0;

h3{
font-size:17px;
margin-bottom:6px;
}
}

.author{
color:var(--accent);
font-size:13px;
margin-bottom:0;
}

.card-right{
display:flex;
align-items:center;
gap:8px;
flex-shrink:0;
}

.lang-badge{
font-size:11px;
font-weight:700;
padding:4px 10px;
border-radius:20px;
white-space:nowrap;
}

.lang-badge.fa{
background:color-mix(in srgb, #2b9348 18%, transparent);
color:#2b9348;
}

.lang-badge.ar{
background:color-mix(in srgb, #e07b39 18%, transparent);
color:#e07b39;
}

:global(.dark) .lang-badge.fa{
background:color-mix(in srgb, #4ade80 18%, transparent);
color:#4ade80;
}

:global(.dark) .lang-badge.ar{
background:color-mix(in srgb, #fb923c 18%, transparent);
color:#fb923c;
}

.chevron{
color:var(--gray);
flex-shrink:0;
transition:transform .3s ease, color .2s;

.book-card:hover &{
color:var(--accent);
}

.book-card.open &{
transform:rotate(180deg);
color:var(--accent);
}
}

.accordion-body{
max-height:0;
overflow:hidden;
transition:max-height .35s ease;
}

.desc{
color:var(--gray);
font-size:13px;
line-height:1.8;
margin:0;
padding-top:14px;
}

.desc-row{
display:flex;
justify-content:flex-end;
align-items:center;
margin-top:8px;
}

.more-btn{
padding:5px 14px;
background:color-mix(in srgb, var(--accent) 12%, transparent);
color:var(--accent);
border-radius:20px;
font-size:12px;
font-weight:600;
text-decoration:none;
transition:background .2s, transform .2s;
flex-shrink:0;

&:hover{
background:color-mix(in srgb, var(--accent) 22%, transparent);
transform:translateY(-1px);
}
}

.meta-line{
display:flex;
justify-content:space-between;
align-items:center;
border-top:1px solid var(--border);
padding-top:12px;
margin-top:12px;
}

.year{
color:var(--gray);
font-size:12px;
}

.meta-info{
display:flex;
gap:12px;
color:var(--gray);
font-size:12px;
}

</style>
