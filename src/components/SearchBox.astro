---
import { getUi } from "../i18n/index.js";

const { locale = "fa" } = Astro.props;
const t = getUi(locale);
---

<div class="search" data-translator={t.search.translator} data-base={import.meta.env.BASE_URL || "/"}>

    <div class="search-inner">

        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="11" cy="11" r="8"/>
            <line x1="21" y1="21" x2="16.65" y2="16.65"/>
        </svg>

        <input
        type="text"
        placeholder={t.search.placeholder}
        autocomplete="off"
        spellcheck="false"
        data-search-input
        />

        <button class="search-clear" data-search-clear title={t.search.clear}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <line x1="18" y1="6" x2="6" y2="18"/>
                <line x1="6" y1="6" x2="18" y2="18"/>
            </svg>
        </button>

    </div>

    <div class="search-results" data-search-results>

        <p class="results-empty" data-results-empty>{t.search.empty}</p>

        <div class="results-list" data-results-list></div>

    </div>

<script is:inline type="module">
const initSearch = () => {
    const langClass = (lang) => {
        const l = String(lang || "");
        if (l.includes("فارسی") || l.includes("persian")) return "fa";
        if (l.includes("اردو") || l.includes("urdu")) return "ur";
        if (l.includes("عربی") || l.includes("arabic")) return "ar";
        return "";
    };

    document.querySelectorAll("[data-search-input]").forEach((input) => {
        if (input.dataset.bound) return;
        input.dataset.bound = "1";

        const cidAttr = "data-astro-cid-" + (input.getAttributeNames().find((n) => n.startsWith("data-astro-cid-")) || "").replace("data-astro-cid-", "");

        input.addEventListener("input", () => {
            const root = input.closest(".search");
            clearTimeout(input._searchTimeout);
            input._searchTimeout = setTimeout(async () => {
                const list = root?.querySelector("[data-results-list]");
                const base = root?.dataset.base || "/";
                const translatorLabel = root?.dataset.translator || "";
                const resultsBox = root?.querySelector("[data-search-results]");
                const empty = root?.querySelector("[data-results-empty]");
                const clearBtn = root?.querySelector("[data-search-clear]");
                const query = input.value;

                if (!query.trim()) {
                    if (list) list.innerHTML = "";
                    if (resultsBox) resultsBox.classList.remove("open");
                    if (empty) empty.classList.remove("show");
                    if (clearBtn) clearBtn.classList.remove("show");
                    return;
                }

                if (clearBtn) clearBtn.classList.add("show");

                try {
                    if (!window.__pagefind) {
                        const mod = await import(base + "pagefind/pagefind.js");
                        const pf = mod.default || mod;
                        if (typeof pf.init === "function") await pf.init();
                        window.__pagefind = pf;
                    }
                    const pf = window.__pagefind;
                    if (!pf) return;

                    const results = await pf.search(query);
                    const allData = await Promise.all(results.results.slice(0, 20).map((r) => r.data()));

                    const bookResults = allData.filter((item) => {
                        const u = item.url || "";
                        return u.includes("/books/") && item.meta?.category;
                    }).slice(0, 7);

                    if (empty) empty.classList.toggle("show", bookResults.length === 0);
                    if (resultsBox) resultsBox.classList.toggle("open", bookResults.length > 0);

                    if (list) {
                        list.innerHTML = bookResults
                            .map((item) => {
                                const cat = item.meta?.category || "";
                                const lang = item.meta?.language || "";
                                const author = item.meta?.author || "";
                                const translator = item.meta?.translator || "";
                                const langCls = langClass(lang);
                                const authorLine = translator ? author + " — " + translatorLabel + " " + translator : author;
                                return `
                                <a class="result" href="${item.url}" ${cidAttr}>
                                    <span class="result-cat" ${cidAttr}>${cat}</span>
                                    <span class="result-title" ${cidAttr}>${item.meta?.title || ""}</span>
                                    <span class="result-author" ${cidAttr}>${authorLine}</span>
                                    ${lang ? `<span class="result-lang ${langCls}" ${cidAttr}>${lang}</span>` : ""}
                                </a>`;
                            })
                            .join("");
                    }
                } catch (e) {
                    console.warn("Search error:", e);
                }
            }, 80);
        });

        input.addEventListener("focus", () => {
            if (input.value.trim()) input.dispatchEvent(new Event("input"));
        });
    });

    document.querySelectorAll("[data-search-clear]").forEach((btn) => {
        if (btn.dataset.bound) return;
        btn.dataset.bound = "1";
        btn.addEventListener("click", () => {
            const root = btn.closest(".search");
            const input = root?.querySelector("[data-search-input]");
            const list = root?.querySelector("[data-results-list]");
            const resultsBox = root?.querySelector("[data-search-results]");
            const empty = root?.querySelector("[data-results-empty]");
            if (input) input.value = "";
            if (list) list.innerHTML = "";
            if (resultsBox) resultsBox.classList.remove("open");
            if (empty) empty.classList.remove("show");
            btn.classList.remove("show");
            if (input) input.focus();
        });
    });

    if (!window.__searchDocBound) {
        window.__searchDocBound = true;
        document.addEventListener("click", (e) => {
            if (!e.target.closest(".search")) {
                document.querySelectorAll("[data-search-results]").forEach((el) => el.classList.remove("open"));
            }
        });
    }
};

initSearch();
document.addEventListener("astro:page-load", initSearch);
</script>

</div>

<style lang="scss">

.search{
position:relative;
width:100%;

.search-inner{
position:relative;

.search-icon{
position:absolute;
right:14px;
top:50%;
transform:translateY(-50%);
width:17px;
height:17px;
color:var(--gray);
pointer-events:none;
}

input{
width:100%;
min-width:0;
height:42px;
border-radius:22px;
border:1px solid var(--border);
background:var(--bg);
color:var(--text);
padding:0 40px 0 38px;
outline:none;
font-size:14px;
transition:border-color .3s ease, background .6s ease, color .6s ease;

&::placeholder{
color:var(--gray);
}

&:focus{
border-color:var(--accent);
box-shadow:0 0 0 3px color-mix(in srgb, var(--accent) 20%, transparent);
}
}

.search-clear{
position:absolute;
left:10px;
top:50%;
transform:translateY(-50%);
width:26px;
height:26px;
border-radius:50%;
border:none;
background:var(--card);
color:var(--gray);
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
opacity:0;
visibility:hidden;
transition:opacity .2s ease, visibility .2s, background .3s ease, color .3s ease;

svg{
width:13px;
height:13px;
}

&.show{
opacity:1;
visibility:visible;
}

&:hover{
background:var(--accent);
color:#fff;
}
}
}

.search-results{
position:absolute;
top:calc(100% + 8px);
right:0;
left:0;
background:var(--card);
border:1px solid var(--border);
border-radius:16px;
box-shadow:0 20px 50px rgba(0,0,0,.2);
z-index:500;
overflow:hidden;
opacity:0;
visibility:hidden;
transform:translateY(-8px);
transition:opacity .25s ease, transform .25s ease, visibility .25s;

&.open{
opacity:1;
visibility:visible;
transform:translateY(0);
}
}
}

.results-empty{
display:none;
padding:20px;
text-align:center;
color:var(--gray);
font-size:13px;

&.show{
display:block;
}
}

.results-list{
max-height:360px;
overflow-y:auto;
display:flex;
flex-direction:column;
}

.result{
display:flex;
align-items:center;
gap:8px;
padding:10px 14px;
text-decoration:none;
transition:background .2s ease;

& + .result{
border-top:1px solid color-mix(in srgb, var(--border) 60%, transparent);
}

&:hover{
background:color-mix(in srgb, var(--accent) 8%, transparent);
}
}

.result-cat{
flex-shrink:0;
font-size:10px;
padding:3px 10px;
border-radius:12px;
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.result-title{
flex:0 1 auto;
min-width:0;
max-width:50%;
font-size:14px;
font-weight:700;
color:var(--text);
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
}

.result-author{
flex:1;
min-width:0;
font-size:11px;
font-weight:400;
color:var(--gray);
white-space:nowrap;
overflow:hidden;
text-overflow:ellipsis;
opacity:.7;
}

.result-lang{
flex-shrink:0;
font-size:10px;
font-weight:600;
padding:3px 10px;
border-radius:20px;
white-space:nowrap;

&.fa{
background:color-mix(in srgb, #2b9348 15%, transparent);
color:#2b9348;
}

&.ar{
background:color-mix(in srgb, #e07b39 15%, transparent);
color:#e07b39;
}

&.ur{
background:color-mix(in srgb, #3b82f6 15%, transparent);
color:#3b82f6;
}

:global(.dark) &.fa{
background:color-mix(in srgb, #4ade80 15%, transparent);
color:#4ade80;
}

:global(.dark) &.ar{
background:color-mix(in srgb, #fb923c 15%, transparent);
color:#fb923c;
}

:global(.dark) &.ur{
background:color-mix(in srgb, #60a5fa 15%, transparent);
color:#60a5fa;
}
}

</style>
