---
import SunIcon from "./icons/SunIcon.astro";
import MoonIcon from "./icons/MoonIcon.astro";
---

<button class="theme-btn" title="تم شب و روز" data-tip="تم شب و روز">

<span class="icon-moon"><MoonIcon /></span>
<span class="icon-sun"><SunIcon /></span>

</button>

<script>
const html = document.documentElement;

document.querySelectorAll(".theme-btn").forEach((button) => {
    button?.addEventListener("click", () => {
        html.classList.add("theme-anim");

        button.classList.remove("spin");
        void button.offsetWidth;
        button.classList.add("spin");

        const isDark = html.classList.toggle("dark");
        localStorage.setItem("theme", isDark ? "dark" : "light");
        window.setTimeout(() => {
            html.classList.remove("theme-anim");
            button.classList.remove("spin");
        }, 650);
    });
});
</script>

<style lang="scss">

.theme-btn{
position:relative;
width:42px;
height:42px;
border-radius:50%;
border:1px solid var(--border);
background:var(--bg);
color:var(--text);
cursor:pointer;
transition:background .3s ease, border-color .3s ease;

&::after{
content:attr(data-tip);
position:absolute;
top:calc(100% + 10px);
right:50%;
transform:translateX(50%);
background:var(--text);
color:var(--bg);
font-size:11px;
font-weight:500;
padding:5px 12px;
border-radius:8px;
white-space:nowrap;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, transform .25s ease, visibility .25s;
z-index:50;
}

&::before{
content:"";
position:absolute;
top:calc(100% + 4px);
right:50%;
transform:translateX(50%);
width:0;
height:0;
border:6px solid transparent;
border-bottom-color:var(--text);
border-top:none;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
z-index:50;
}

&.spin{
.icon-moon,
.icon-sun{
animation:theme-spin .6s cubic-bezier(.34,1.56,.64,1);
}
}

@keyframes theme-spin{
0%{
transform:scale(.9) rotate(0deg);
}

50%{
transform:scale(1.15) rotate(20deg);
}

100%{
transform:scale(1) rotate(0deg);
}
}

.icon-moon,
.icon-sun{
position:absolute;
inset:0;
display:flex;
align-items:center;
justify-content:center;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

svg{
display:block;
transition:transform .6s cubic-bezier(.34,1.56,.64,1);
}

.icon-sun{
opacity:0;
transform:scale(.4) rotate(-90deg);

svg{
transform:rotate(-90deg);
}
}

:global(.dark) &{
.icon-moon{
opacity:0;
transform:scale(.4) rotate(90deg);

svg{
transform:rotate(90deg);
}
}

.icon-sun{
opacity:1;
transform:scale(1) rotate(0);

svg{
transform:rotate(0);
}
}
}

&:hover{
background:var(--accent);
color:#fff;

&::after{
opacity:1;
visibility:visible;
}

&::before{
opacity:1;
visibility:visible;
}
}
}

</style>
