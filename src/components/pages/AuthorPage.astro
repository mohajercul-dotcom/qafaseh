---
import MainLayout from "../../layouts/MainLayout.astro";
import BookCard from "../BookCard.astro";
import TagFilter from "../TagFilter.astro";
import { allBooks } from "../../lib/paths.js";
import { slugify, normalizeAuthor } from "../../lib/books.js";
import { getUi } from "../../i18n/index.js";
import { localizePath, toLocaleDigits, bookDescription, bookSiteLang } from "../../lib/i18n.js";

const { name, locale = "fa" } = Astro.props;
const t = getUi(locale);

const categoryKeys = ["shiite", "atheism", "aqeedah", "adyan", "maqabeh", "fraq", "daavat"];
const collections = categoryKeys.map((key) => ({ name: key, label: t.menu[key].label }));

const all = await allBooks();

const groups = categoryKeys
    .map((key) => ({
        key,
        label: t.menu[key].label,
        books: all.filter(
            (book) => book.category === key && bookSiteLang(book) === locale && normalizeAuthor(book.data.author) === name
        ),
    }))
    .filter((group) => group.books.length > 0);

const allBooksForAuthor = groups.flatMap((group) =>
    group.books.map((book) => ({ ...book, category: group.key }))
);
const total = allBooksForAuthor.length;
---

<MainLayout>

    <section class="author-header">

        <h1>{name}</h1>

        <p class="stats">
            {groups.map((group) => (
                <span class="badge">{group.label}: {group.books.length}</span>
            ))}
            <span class="badge total">{t.authors.totalBooks(toLocaleDigits(total, locale))}</span>
        </p>

    </section>

    <TagFilter tags={collections.map((c) => c.label)} gridId="books-author" byCategory locale={locale} />
    <div class="books" id="books-author" data-cols="3">
        {allBooksForAuthor.map((book) => (
            <div class="book-item" data-cat={t.menu[book.category].label}>
                <BookCard
                    title={book.data.title}
                    author={book.data.author}
                    description={bookDescription(book, locale)}
                    language={book.data.language}
                    href={localizePath(locale, `/books/${slugify(book.data.title)}`)}
                    tags={book.data.tags || []}
                    locale={locale}
                />
            </div>
        ))}
    </div>

    <script>
        import { initAllGrids } from "../../lib/bookGrid.js";
        import { initBookFilter } from "../../lib/bookFilter.js";
        window.addEventListener("resize", initAllGrids);
        document.addEventListener("astro:page-load", () => {
            initAllGrids();
            initBookFilter();
        });
    </script>

</MainLayout>

<style lang="scss">

.author-header{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

.stats{
display:flex;
justify-content:center;
gap:12px;
margin-top:16px;
flex-wrap:wrap;
}

.badge{
padding:6px 14px;
border-radius:20px;
font-size:13px;
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.badge.total{
background:var(--card);
border:1px solid var(--border);
color:var(--text);
}
}

.books{
display:flex;
gap:16px;
padding:20px 0 40px;
opacity:0;
transition:opacity .2s;

&.ready{
opacity:1;
}
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
.books{
flex-direction:column;
}
}

</style>
