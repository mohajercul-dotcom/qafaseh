---
import { getUi } from "../i18n/index.js";

const { title, author, category, cover, locale = "fa" } = Astro.props;
const t = getUi(locale);
---

{
    cover ? (
        <img class="cover-img" src={cover} alt={title} loading="lazy" decoding="async" />
    ) : (
        <div class:list={["cover-photo", category]}>

            <div class="cover-inner">

                <span class="cover-cat">
                    {category === "shiite" ? t.bookCover.shiite : t.bookCover.atheism}
                </span>

                <h2>{title}</h2>

                <div class="cover-footer">
                    <span class="cover-author">{t.bookCover.translatorPrefix} {author}</span>
                </div>

            </div>

        </div>
    )
}

<style lang="scss">

.cover-img{
width:100%;
border-radius:14px;
box-shadow:0 20px 40px rgba(0,0,0,.2);
}

.cover-photo{
aspect-ratio:2/3;
border-radius:14px;
padding:10px;
box-shadow:0 20px 40px rgba(0,0,0,.22);
transition:transform .4s ease;

&.shiite{
background:linear-gradient(160deg,#1D6A96,#0d3b58);
}

&.atheism{
background:linear-gradient(160deg,#2b2f36,#101318);
}

.cover-inner{
height:100%;
border:1px solid rgba(255,255,255,.25);
border-radius:8px;
padding:18px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:space-between;
text-align:center;
color:#fff;
overflow:hidden;
position:relative;
}

.cover-cat{
font-size:11px;
letter-spacing:.5px;
opacity:.85;
background:rgba(255,255,255,.15);
padding:5px 12px;
border-radius:20px;
}

h2{
font-size:17px;
font-weight:700;
line-height:1.6;
padding:0 6px;
}

.cover-footer{
width:100%;

.cover-author{
display:block;
font-size:12px;
opacity:.9;
border-top:1px solid rgba(255,255,255,.3);
padding-top:10px;
}
}
}

</style>
