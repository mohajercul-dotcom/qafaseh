<script>
const contactOverlay = document.querySelector("[data-contact-overlay]");
const contactModal = document.querySelector("[data-contact-modal]");
const contactClose = document.querySelector("[data-contact-close]");

const openContact = () => {
contactOverlay?.classList.add("open");
document.body.classList.add("modal-open");
};

const closeContact = () => {
contactOverlay?.classList.remove("open");
document.body.classList.remove("modal-open");
};

contactClose?.addEventListener("click", closeContact);

contactOverlay?.addEventListener("click", (e) => {
if (e.target === contactOverlay) {
closeContact();
}
});

document.addEventListener("keydown", (e) => {
if (e.key === "Escape") {
closeContact();
}
});

document.addEventListener("DOMContentLoaded", () => {
const btnContactMobile = document.getElementById("btnContactMobile");
btnContactMobile?.addEventListener("click", () => {
const mbOverlay = document.getElementById("mbOverlay");
const popupBisher = document.getElementById("popupBisher");
mbOverlay?.classList.remove("open");
popupBisher?.classList.remove("open");
openContact();
});

const toggle = document.querySelector("[data-contact-toggle]");
toggle?.addEventListener("click", openContact);
});
</script>

<style lang="scss">

.contact-wrap{
position:relative;
}

.icon-button{
position:relative;
width:42px;
height:42px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
background:var(--bg);
border:1px solid var(--border);
color:var(--gray);
cursor:pointer;
transition:background .3s ease, border-color .3s ease;

:global(svg){
width:20px;
height:20px;
color:currentColor;
}

&::after{
content:attr(data-tip);
position:absolute;
top:calc(100% + 10px);
right:50%;
transform:translateX(50%);
background:var(--text);
color:var(--bg);
font-size:11px;
font-weight:500;
padding:5px 12px;
border-radius:8px;
white-space:nowrap;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, transform .25s ease, visibility .25s;
z-index:60;
}

&::before{
content:"";
position:absolute;
top:calc(100% + 4px);
right:50%;
transform:translateX(50%);
width:0;
height:0;
border:6px solid transparent;
border-bottom-color:var(--text);
border-top:none;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
z-index:60;
}

&:hover{
background:var(--accent);

:global(svg){
color:#fff;
}

&::after{
opacity:1;
visibility:visible;
}

&::before{
opacity:1;
visibility:visible;
}
}
}

.contact-overlay{
position:fixed;
inset:0;
background:rgba(0,0,0,.55);
backdrop-filter:blur(8px);
-webkit-backdrop-filter:blur(8px);
display:flex;
align-items:center;
justify-content:center;
z-index:1000;
opacity:0;
visibility:hidden;
transition:opacity .35s ease, visibility .35s;

&.open{
opacity:1;
visibility:visible;
}
}

.contact-modal{
position:relative;
width:420px;
max-width:calc(100vw - 40px);
background:var(--card);
border:1px solid var(--border);
border-radius:24px;
padding:44px 32px 36px;
text-align:center;
box-shadow:0 30px 80px rgba(0,0,0,.4);
opacity:0;
transform:translateY(30px) scale(.92);
transition:transform .45s cubic-bezier(.34,1.56,.64,1), opacity .35s ease;

.contact-overlay.open &{
opacity:1;
transform:translateY(0) scale(1);
}

.modal-close{
position:absolute;
top:16px;
left:16px;
width:36px;
height:36px;
border-radius:50%;
border:none;
background:var(--text);
color:var(--bg);
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
transition:background .3s ease, color .3s ease, transform .3s ease;

svg{
width:18px;
height:18px;
}

&:hover{
background:var(--accent);
color:#fff;
transform:rotate(90deg);
}
}

.modal-icon{
width:64px;
height:64px;
margin:0 auto 18px;
border-radius:50%;
display:flex;
align-items:center;
justify-content:center;
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
animation:icon-pulse 2.4s ease-in-out infinite;

:global(svg){
width:30px;
height:30px;
}
}

h3{
font-size:20px;
font-weight:900;
margin-bottom:8px;
}

.contact-desc{
font-size:14px;
color:var(--gray);
margin-bottom:24px;
}

.contact-list{
display:flex;
flex-direction:column;
gap:10px;
text-align:right;
}

.contact-item{
display:flex;
align-items:center;
gap:12px;
padding:14px 16px;
background:var(--bg);
border:1px solid var(--border);
border-radius:16px;
color:var(--text);
text-decoration:none;
transition:background .2s, border-color .2s, transform .2s;

&:hover{
background:color-mix(in srgb, var(--accent) 8%, transparent);
border-color:color-mix(in srgb, var(--accent) 30%, transparent);
transform:translateX(-4px);
}
}

.contact-icon{
display:flex;
align-items:center;
justify-content:center;
width:40px;
height:40px;
border-radius:50%;
background:color-mix(in srgb, var(--accent) 12%, transparent);
color:var(--accent);
flex-shrink:0;

:global(svg){
width:20px;
height:20px;
}
}

.contact-text{
flex:1;
}

.contact-label{
font-size:14px;
font-weight:600;
}

.contact-arrow{
color:var(--gray);
flex-shrink:0;
transition:color .2s, transform .2s;

.contact-item:hover &{
color:var(--accent);
transform:translateX(-4px);
}
}
}

@keyframes icon-pulse{
0%,100%{
transform:scale(1);
box-shadow:0 0 0 0 color-mix(in srgb, var(--accent) 25%, transparent);
}
50%{
transform:scale(1.06);
box-shadow:0 0 0 10px transparent;
}
}

</style>
