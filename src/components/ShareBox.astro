---
const { title, author } = Astro.props;

const pageUrl = Astro.url.href;
const shareText = `${title} — ${author}`;
const encodedText = encodeURIComponent(shareText);
const encodedUrl = encodeURIComponent(pageUrl);

const telegram = `https://t.me/share/url?url=${encodedUrl}&text=${encodedText}`;
const whatsapp = `https://wa.me/?text=${encodedText}%20${encodedUrl}`;
const twitter = `https://twitter.com/intent/tweet?text=${encodedText}&url=${encodedUrl}`;
---

<div class="share-box">

    <button class="share-copy" data-copy-url={pageUrl} data-copy-text={shareText}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <rect x="9" y="9" width="13" height="13" rx="2"/>
            <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
        </svg>
        کپی لینک
    </button>

    <a class="share-btn telegram" href={telegram} target="_blank" rel="noopener" title="اشتراک در تلگرام">
        <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M21.9 4.6 18.8 18.7c-.2 1-.8 1.3-1.7.8l-4.6-3.4-2.2 2.1c-.2.2-.4.4-.9.4l.3-4.7L18.3 6c.4-.3-.1-.5-.6-.2L7 12.4l-4.5-1.4c-1-.3-1-1 .2-1.4l17.6-6.8c.8-.3 1.5.2 1.6 1.4z"/>
        </svg>
    </a>

    <a class="share-btn whatsapp" href={whatsapp} target="_blank" rel="noopener" title="اشتراک در واتساپ">
        <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm5.2 14.1c-.2.6-1.2 1.2-1.7 1.2-.4.1-1 .1-1.6-.1-2.6-.9-4.9-3.3-6.2-5.5-.5-.8-.9-1.7-.9-2.4 0-.7.3-1.4.8-1.9.2-.2.4-.3.6-.3h.5c.2 0 .4 0 .6.5l.8 1.9c.1.2.1.4 0 .6l-.4.6-.3.4c.2.3.4.7.8 1.1.5.6 1.1 1.1 1.6 1.4.3.2.6.3.8.2l.5-.6.9-1c.2-.3.4-.2.7-.1l1.8.9c.2.1.4.2.4.4 0 .1 0 .5-.3 1.1z"/>
        </svg>
    </a>

    <a class="share-btn twitter" href={twitter} target="_blank" rel="noopener" title="اشتراک در X">
        <svg viewBox="0 0 24 24" fill="currentColor">
            <path d="M18.2 2h3.3l-7.3 8.3L22.7 22h-6.7l-5.3-6.9L4.7 22H1.4l7.8-8.9L1.4 2h6.9l4.7 6.3L18.2 2zm-1.2 18h1.8L7 3.9H5L17 20z"/>
        </svg>
    </a>

</div>

<script>
const copyBtn = document.querySelector(".share-copy");

copyBtn?.addEventListener("click", async () => {
    const url = copyBtn.dataset.copyUrl;
    const text = copyBtn.dataset.copyText;
    const payload = `${text}\n${url}`;

    try {
        await navigator.clipboard.writeText(payload);
        const label = copyBtn.querySelector("svg");
        const old = copyBtn.innerHTML;
        copyBtn.innerHTML = "لینک کپی شد ✓";
        copyBtn.classList.add("copied");
        setTimeout(() => {
            copyBtn.innerHTML = old;
            copyBtn.classList.remove("copied");
        }, 2000);
    } catch {
        copyBtn.innerHTML = "خطا";
        setTimeout(() => {
            copyBtn.innerHTML = old;
        }, 2000);
    }
});
</script>

<style lang="scss">

.share-box{
display:flex;
gap:8px;
align-items:center;
}

.share-copy{
flex:1;
display:inline-flex;
align-items:center;
justify-content:center;
gap:8px;
padding:12px 14px;
border-radius:12px;
border:1px solid var(--border);
background:var(--card);
color:var(--text);
font-size:13px;
font-weight:500;
cursor:pointer;
transition:background .3s ease, border-color .3s ease, color .3s ease;

svg{
width:18px;
height:18px;
}

&:hover{
background:var(--accent);
border-color:var(--accent);
color:#fff;
}

&.copied{
background:var(--accent);
border-color:var(--accent);
color:#fff;
}
}

.share-btn{
width:44px;
height:44px;
border-radius:12px;
display:flex;
align-items:center;
justify-content:center;
border:1px solid var(--border);
background:var(--card);
color:var(--text);
transition:transform .25s ease, background .3s ease, color .3s ease;

svg{
width:20px;
height:20px;
}

&:hover{
transform:translateY(-2px);
color:#fff;
}

&.telegram:hover{
background:#229ED9;
border-color:#229ED9;
}

&.whatsapp:hover{
background:#25D366;
border-color:#25D366;
}

&.twitter:hover{
background:#000;
border-color:#000;
}
}

</style>
