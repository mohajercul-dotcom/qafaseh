---
const { tags, gridId, byCategory = false } = Astro.props;
---

{tags.length > 0 && (
    <div class="filter-wrap" data-filter-bar data-grid={gridId}>

        <button class="filter-arrow arrow-right" type="button" aria-label="فیلتر بعدی">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 6 15 12 9 18"/></svg>
        </button>

        <div class="filter-bar">
            {byCategory ? (
                <button class="filter-chip active" data-cat="">همه</button>
            ) : (
                <button class="filter-chip active" data-tag="">همه</button>
            )}
            {tags.map((tag) => (
                byCategory ? (
                    <button class="filter-chip" data-cat={tag}>{tag}</button>
                ) : (
                    <button class="filter-chip" data-tag={tag}>{tag}</button>
                )
            ))}
        </div>

        <button class="filter-arrow arrow-left" type="button" aria-label="فیلتر قبلی">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 6 9 12 15 18"/></svg>
        </button>

    </div>
)}

<script>
let filterRefs = null;
let windowFilterBound = false;

const update = () => {
    const refs = filterRefs;
    if (!refs) return;
    const { wrap, bar, arrowL, arrowR } = refs;
    const overflow = bar.scrollWidth > bar.clientWidth + 2;
    wrap.classList.toggle("overflow", overflow);
    bar.classList.toggle("overflow", overflow);
    wrap.classList.toggle("show-arrows", overflow);

    const max = Math.max(0, bar.scrollWidth - bar.clientWidth);
    arrowL.classList.toggle("disabled", !overflow || bar.scrollLeft <= 2);
    arrowR.classList.toggle("disabled", !overflow || bar.scrollLeft >= max - 2);
};

const initFilter = () => {
    const wrap = document.querySelector("[data-filter-bar]");
    if (!wrap || wrap.dataset.bound) return;
    wrap.dataset.bound = "1";
    const bar = wrap.querySelector(".filter-bar");
    const arrowR = wrap.querySelector(".arrow-right");
    const arrowL = wrap.querySelector(".arrow-left");
    if (!bar) return;
    filterRefs = { wrap, bar, arrowL, arrowR };

    const step = () => {
        const chip = bar.querySelector(".filter-chip");
        return chip ? (chip.offsetWidth + 8) * 3 : bar.clientWidth * 0.4;
    };

    arrowR?.addEventListener("click", () => bar.scrollBy({ left: step(), behavior: "smooth" }));
    arrowL?.addEventListener("click", () => bar.scrollBy({ left: -step(), behavior: "smooth" }));

    bar.addEventListener("click", (e) => {
        const chip = e.target.closest(".filter-chip");
        if (!chip) return;
        if (bar.scrollWidth > bar.clientWidth + 2) {
            chip.scrollIntoView({ inline: "center", block: "nearest", behavior: "smooth" });
        }
    });

    bar.addEventListener("scroll", update, { passive: true });
    update();
    setTimeout(update, 300);
    setTimeout(update, 1000);

    if (!windowFilterBound) {
        windowFilterBound = true;
        window.addEventListener("resize", update);
        window.addEventListener("load", update);
    }
};
initFilter();
document.addEventListener("astro:page-load", initFilter);
</script>

<style lang="scss">

.filter-wrap{
position:relative;
padding:10px 0 2px;
}

.filter-bar{
display:flex;
flex-wrap:nowrap;
gap:8px;
justify-content:flex-start;
overflow-x:auto;
scrollbar-width:none;
-ms-overflow-style:none;
padding:4px 46px;
scroll-behavior:smooth;

&::-webkit-scrollbar{
display:none;
}

&:not(.overflow) .filter-chip:first-child{
margin-inline-start:auto;
}

&:not(.overflow) .filter-chip:last-child{
margin-inline-end:auto;
}

&.overflow{
mask-image:linear-gradient(to left, transparent 0, #000 18px, #000 calc(100% - 48px), transparent calc(100% - 34px), transparent 100%);
-webkit-mask-image:linear-gradient(to left, transparent 0, #000 18px, #000 calc(100% - 48px), transparent calc(100% - 34px), transparent 100%);
}
}

.filter-chip{
flex-shrink:0;
border:1px solid var(--border);
background:var(--card);
color:var(--gray);
padding:6px 16px;
border-radius:20px;
font-size:12px;
font-weight:600;
cursor:pointer;
transition:background .2s ease, color .2s ease, border-color .2s ease;

&:hover{
border-color:var(--accent);
color:var(--accent);
}

&.active{
background:var(--accent);
border-color:var(--accent);
color:#fff;
}
}

.filter-arrow{
position:absolute;
top:50%;
transform:translateY(-50%);
width:34px;
height:34px;
border-radius:50%;
border:1px solid var(--border);
background:var(--card);
color:var(--accent);
display:none;
align-items:center;
justify-content:center;
cursor:pointer;
box-shadow:0 4px 14px rgba(0,0,0,.12);
transition:background .2s ease, color .2s ease, opacity .2s ease;
z-index:2;

.filter-wrap.show-arrows &{
display:flex;
}

svg{
width:18px;
height:18px;
}

&:hover{
background:var(--accent);
color:#fff;
}

&.disabled{
pointer-events:none;
}
}

.arrow-right{
right:2px;
}

.arrow-left{
left:2px;
}

@media(max-width:900px){
.filter-bar{
padding:4px 38px;
}

.filter-bar.overflow{
mask-image:linear-gradient(to left, transparent 0, #000 16px, #000 calc(100% - 40px), transparent calc(100% - 30px), transparent 100%);
-webkit-mask-image:linear-gradient(to left, transparent 0, #000 16px, #000 calc(100% - 40px), transparent calc(100% - 30px), transparent 100%);
}

.filter-arrow{
width:30px;
height:30px;
}
}

</style>
