---
import SearchBox from "./SearchBox.astro";
import ThemeToggle from "./ThemeToggle.astro";
import IconButton from "./IconButton.astro";
import Logo from "./Logo.astro";
import AboutPopup from "./AboutPopup.astro";

const path = Astro.url.pathname;

const { searchIndex = [] } = Astro.props;

const menuItems = [
    { href: "/shiite", label: "شیعه", tip: "شیعه‌شناسی" },
    { href: "/atheism", label: "الحاد", tip: "نقد الحاد" },
    { href: "/authors", label: "نویسندگان", tip: "نویسندگان و آثارشان" },
];
---

<header>

<div class="container nav">

<nav class="right-menu">

<Logo />

{
    menuItems.map((item) => (
        <a
            class:list={["menu-link", { active: path === item.href || path.startsWith(item.href + "/") }]}
            href={item.href}
            data-tip={item.tip}
        >{item.label}</a>
    ))
}

</nav>

<SearchBox searchIndex={searchIndex} />

<div class="left-menu">

<ThemeToggle />

<IconButton
icon="grid.svg"
title="پروژه‌های دیگر"
href="https://mohajercul.vercel.app/"
/>

<AboutPopup />

<IconButton
icon="mail.svg"
title="تماس با ما"
/>

</div>

</div>

<nav class="bottom-nav" aria-label="منوی پایین">

<a class="bottom-link" href="/" data-tip="خانه">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M3 12l9-9 9 9"/><rect x="5" y="10" width="14" height="12" rx="2"/><line x1="9" y1="22" x2="9" y2="15"/><line x1="15" y1="22" x2="15" y2="15"/></svg>
<span>خانه</span>
</a>

<div class="bottom-dropdown">
<button class="bottom-link" data-tip="دسته‌ها">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg>
<span>دسته</span>
</button>
<div class="dropdown-menu">
{menuItems.map((item) => (
    <a class="dropdown-item" href={item.href} data-tip={item.tip}>{item.label}</a>
))}
</div>
</div>

<button class="bottom-link" id="themeToggleBottom" title="تم" data-tip="تم شب و روز">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" class="icon-sun"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22" class="icon-moon" style="display:none"><path d="M21 12.79A9 9 0 1111.21 3 7 7 0 0021 12.79z"/></svg>
<span>تم</span>
</button>

<a class="bottom-link" href="https://mohajercul.vercel.app/" target="_blank" rel="noopener" data-tip="پروژه‌های دیگر">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><rect x="2" y="6" width="20" height="12" rx="2"/><line x1="6" y1="12" x2="6" y2="12"/><line x1="10" y1="12" x2="10" y2="12"/><line x1="14" y1="12" x2="14" y2="12"/><line x1="18" y1="12" x2="18" y2="12"/></svg>
<span>پروژه‌ها</span>
</a>

<button class="bottom-link" id="aboutBtnBottom" title="درباره ما" data-tip="درباره ما">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
<span>درباره ما</span>
</button>

<a class="bottom-link" href="mailto:info@example.com" data-tip="تماس با ما">
<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="22" height="22"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>
<span>تماس</span>
</a>

</nav>

</header>

<style lang="scss">

header{
position:fixed;
top:0;
left:0;
right:0;
z-index:50;
height:80px;
background:var(--card);
border-bottom:1px solid var(--border);
box-shadow:0 1px 3px rgba(0,0,0,.04);
transition:background .6s ease, border-color .6s ease, box-shadow .6s ease;

@media(max-width:900px){
box-shadow:0 1px 3px rgba(0,0,0,.06);
}

.nav{
height:100%;
display:grid;
grid-template-columns:1fr 400px 1fr;
align-items:center;
}

.right-menu{
display:flex;
gap:6px;
list-style:none;
justify-content:flex-start;
align-items:center;

:global(.logo){
margin-left:4px;
}

.menu-link{
position:relative;
font-size:16px;
color:var(--text);
padding:7px 8px;
border-radius:12px;
border:1px solid transparent;
background:transparent;
transition:color .2s, background .3s ease, border-color .3s ease;

&.active{
color:var(--accent);
font-weight:700;
background:color-mix(in srgb, var(--accent) 12%, transparent);
border-color:color-mix(in srgb, var(--accent) 30%, transparent);
}

&::after{
content:attr(data-tip);
position:absolute;
top:calc(100% + 10px);
right:50%;
transform:translateX(50%);
background:var(--text);
color:var(--bg);
font-size:11px;
font-weight:500;
padding:5px 12px;
border-radius:8px;
white-space:nowrap;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, transform .25s ease, visibility .25s;
z-index:50;
}

&::before{
content:"";
position:absolute;
top:calc(100% + 4px);
right:50%;
transform:translateX(50%);
width:0;
height:0;
border:6px solid transparent;
border-bottom-color:var(--text);
border-top:none;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
z-index:50;
}

&:hover{
color:var(--accent);

&::after{
opacity:1;
visibility:visible;
}

&::before{
opacity:1;
visibility:visible;
}
}
}
}

.left-menu{
display:flex;
justify-content:flex-end;
gap:12px;
}

.bottom-nav{
display:none;
position:fixed;
bottom:0;
left:0;
right:0;
z-index:50;
background:var(--card);
border-top:1px solid var(--border);
box-shadow:0 -1px 6px rgba(0,0,0,.06);
padding:6px 4px 8px;
justify-content:space-around;
align-items:center;
gap:2px;
overflow-x:auto;
-webkit-overflow-scrolling:touch;
scrollbar-width:none;

&::-webkit-scrollbar{display:none;}
}

.bottom-link{
display:flex;
flex-direction:column;
align-items:center;
justify-content:center;
gap:2px;
padding:6px 10px;
border:none;
background:transparent;
color:var(--gray);
font-size:10px;
font-family:inherit;
cursor:pointer;
border-radius:10px;
transition:color .2s, background .2s;
min-width:56px;
text-decoration:none;
position:relative;
white-space:nowrap;

&.active{
color:var(--accent);
background:color-mix(in srgb, var(--accent) 10%, transparent);
}

&:hover{
color:var(--accent);
}

svg{
width:22px;
height:22px;
}

span{
font-size:10px;
line-height:1.2;
}
}

.bottom-dropdown{
position:relative;

.dropdown-menu{
position:absolute;
bottom:calc(100% + 8px);
right:0;
background:var(--card);
border:1px solid var(--border);
border-radius:14px;
padding:8px 0;
box-shadow:0 -4px 20px rgba(0,0,0,.12);
z-index:60;
display:none;
flex-direction:column;
min-width:140px;

&.open{
display:flex;
}
}

.dropdown-item{
display:block;
padding:10px 18px;
color:var(--text);
text-decoration:none;
font-size:14px;
border-radius:8px;
margin:0 4px;
transition:background .2s, color .2s;

&:hover{
background:color-mix(in srgb, var(--accent) 10%, transparent);
color:var(--accent);
}

&.active{
color:var(--accent);
font-weight:700;
background:color-mix(in srgb, var(--accent) 12%, transparent);
}
}
}

@media(max-width:900px){
height:auto;
padding:0;

.nav{
display:none;
}

.bottom-nav{
display:flex;
}
}
}

</style>

<script is:inline>
document.addEventListener("DOMContentLoaded", () => {
const dropdownBtn = document.querySelector(".bottom-dropdown > .bottom-link");
const dropdownMenu = document.querySelector(".dropdown-menu");
const aboutBtn = document.getElementById("aboutBtnBottom");
const themeBtn = document.getElementById("themeToggleBottom");

if(dropdownBtn && dropdownMenu){
dropdownBtn.addEventListener("click", (e) => {
e.stopPropagation();
dropdownMenu.classList.toggle("open");
});
document.addEventListener("click", (e) => {
if(!dropdownBtn.contains(e.target) && !dropdownMenu.contains(e.target)){
dropdownMenu.classList.remove("open");
}
});
}

if(aboutBtn){
aboutBtn.addEventListener("click", () => {
const overlay = document.querySelector("[data-about-overlay]");
if(overlay) overlay.classList.toggle("open");
});
}

if(themeBtn){
themeBtn.addEventListener("click", () => {
const html = document.documentElement;
html.classList.add("theme-anim");
const btn = themeBtn;
btn.classList.remove("spin");
void btn.offsetWidth;
btn.classList.add("spin");
const isDark = html.classList.toggle("dark");
localStorage.setItem("theme", isDark ? "dark" : "light");
window.setTimeout(() => {
html.classList.remove("theme-anim");
btn.classList.remove("spin");
}, 650);
});
}

const path = window.location.pathname;
document.querySelectorAll(".bottom-link").forEach((link) => {
const href = link.getAttribute("href");
if(href === "/" || href === path){
link.classList.add("active");
}
});
document.querySelectorAll(".dropdown-item").forEach((item) => {
const href = item.getAttribute("href");
if(href && path.startsWith(href)){
item.classList.add("active");
}
});
});
</script>