---
import VaraqIcon from "./icons/VaraqIcon.astro";
---

<a class="logo" href="/" title="قفسه — صفحه اصلی" data-tip="قفسه">

    <span class="logo-book">
        <VaraqIcon />
    </span>

</a>

<style lang="scss">

.logo{
position:relative;
display:inline-flex;
align-items:center;
text-decoration:none;
transition:opacity .2s ease;

&:hover{
opacity:.85;
}

&::after{
content:attr(data-tip);
position:absolute;
top:calc(100% + 10px);
right:50%;
transform:translateX(50%);
background:var(--text);
color:var(--bg);
font-size:11px;
font-weight:500;
padding:5px 12px;
border-radius:8px;
white-space:nowrap;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, transform .25s ease, visibility .25s;
z-index:50;
}

&::before{
content:"";
position:absolute;
top:calc(100% + 4px);
right:50%;
transform:translateX(50%);
width:0;
height:0;
border:6px solid transparent;
border-bottom-color:var(--text);
border-top:none;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
z-index:50;
}

&:hover{
&::after{
opacity:1;
visibility:visible;
}

&::before{
opacity:1;
visibility:visible;
}
}
}

.logo-book{
width:46px;
height:46px;
border-radius:13px;
background:var(--logo-bg);
color:var(--logo-text);
display:flex;
align-items:center;
justify-content:center;
box-shadow:0 4px 14px color-mix(in srgb, var(--logo-bg) 35%, transparent);
transition:background .6s ease, box-shadow .6s ease, color .6s ease;

:global(svg){
width:30px;
height:30px;
display:block;
}
}

</style>
