---
import "../styles/global.scss";
import Header from "../components/Header.astro";
import IconFromFile from "../components/icons/IconFromFile.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const title = "قفسه";
const description = "معرفی کتاب‌ها، نویسندگان و اندیشه‌ها";

const shiiteBooks = await getCollection("shiite");
const atheismBooks = await getCollection("atheism");
const aqeedahBooks = await getCollection("aqeedah");
const adyanBooks = await getCollection("adyan");
const maqabehBooks = await getCollection("maqabeh");
const fraqBooks = await getCollection("fraq");
const daavatBooks = await getCollection("daavat");

const searchIndex = [
    ...shiiteBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "شیعه",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...atheismBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "الحاد",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...aqeedahBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "عقیده",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...adyanBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "ادیان",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...maqabehBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "مکاتب فکری",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...fraqBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "فرق",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...daavatBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "دعوت",
        href: `/books/${slugify(b.data.title)}`,
    })),
];
---

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<title>{title}</title>

<meta name="description" content={description} />

</head>

<body>

<Header searchIndex={searchIndex} />

<main class="container">

<slot />

</main>

<button class:list={["back-to-top", { "is-home": Astro.url.pathname === "/" }]} id="backToTop" data-tip="پرش به بالا" aria-label="پرش به بالا">
<IconFromFile src="scroll-top.svg" />
</button>

 <script is:inline>

const savedTheme = localStorage.getItem("theme");

if(savedTheme === "dark"){
document.documentElement.classList.add("dark");
}

const setHeaderOffset = () => {
    const header = document.querySelector("header");
    const main = document.querySelector("main");
    if (header && main) {
        const isMobile = window.innerWidth <= 900;
        const extra = isMobile ? 5 : 10;
        const bottomNavHeight = isMobile ? 90 : 0;
        main.style.paddingTop = (header.offsetHeight + extra) + "px";
        main.style.paddingBottom = bottomNavHeight + "px";
    }
};
if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setHeaderOffset);
} else {
    setHeaderOffset();
}
window.addEventListener("resize", setHeaderOffset);

</script>

<script is:inline>
(function(){
const btn = document.getElementById("backToTop");
if(!btn) return;
const onScroll = () => {
btn.classList.toggle("show", window.scrollY > 400);
};
onScroll();
window.addEventListener("scroll", onScroll, {passive:true});
btn.addEventListener("click", () => {
window.scrollTo({top:0, behavior:"smooth"});
});
})();
</script>

</body>

</html>

<style lang="scss">

html{
background:var(--bg);
}

body{
min-height:100vh;
}

main{
min-height:100vh;
padding:10px 0;
}

@media(max-width:900px){
main{
height:auto;
padding-top:7px;
padding-bottom:80px;
}
}

.back-to-top{
position:fixed;
bottom:24px;
left:24px;
z-index:70;
width:48px;
height:48px;
border-radius:14px;
border:1px solid rgba(255,255,255,.45);
background:rgba(255,255,255,.92);
backdrop-filter:blur(16px) saturate(180%);
-webkit-backdrop-filter:blur(16px) saturate(180%);
box-shadow:0 2px 6px rgba(0,0,0,.08), 0 12px 36px rgba(0,0,0,.1), inset 0 1px 0 rgba(255,255,255,.45);
color:var(--accent);
display:flex;
align-items:center;
justify-content:center;
cursor:pointer;
opacity:0;
visibility:hidden;
transform:translateY(16px);
transition:opacity .3s ease, visibility .3s, transform .3s cubic-bezier(.34,1.56,.64,1), background .3s ease, border-color .3s ease, color .3s ease;

:global(svg){
width:22px;
height:22px;
}

&.show{
opacity:1;
visibility:visible;
transform:translateY(0);
}

&:hover{
background:var(--accent);
border-color:transparent;
color:#fff;
}

:global(.dark) &{
background:rgba(44,40,35,.65);
border-color:rgba(255,255,255,.2);
box-shadow:0 2px 8px rgba(255,255,255,.06), 0 12px 36px rgba(0,0,0,.4), inset 0 1px 0 rgba(255,255,255,.1);
}

@media(min-width:901px){
&::after{
content:attr(data-tip);
position:absolute;
bottom:calc(100% + 10px);
left:50%;
transform:translateX(-50%);
background:var(--text);
color:var(--bg);
font-size:11px;
font-weight:500;
padding:5px 12px;
border-radius:8px;
white-space:nowrap;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
}

&::before{
content:"";
position:absolute;
bottom:calc(100% + 4px);
left:50%;
transform:translateX(-50%);
width:0;
height:0;
border:6px solid transparent;
border-top-color:var(--text);
border-bottom:none;
opacity:0;
visibility:hidden;
pointer-events:none;
transition:opacity .25s ease, visibility .25s;
}

&:hover::after,
&:hover::before{
opacity:1;
visibility:visible;
}
}
}

@media(max-width:900px){
.back-to-top{
bottom:100px;
left:16px;
width:44px;
height:44px;
}
}

.back-to-top.is-home{
display:none;
}

</style>
