---
import "../styles/global.scss";
import Header from "../components/Header.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const title = "قفسه";
const description = "معرفی کتاب‌ها، نویسندگان و اندیشه‌ها";

const shiiteBooks = await getCollection("shiite");
const atheismBooks = await getCollection("atheism");
const aqeedahBooks = await getCollection("aqeedah");
const adyanBooks = await getCollection("adyan");
const maqabehBooks = await getCollection("maqabeh");
const fraqBooks = await getCollection("fraq");
const daavatBooks = await getCollection("daavat");

const searchIndex = [
    ...shiiteBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "شیعه",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...atheismBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "الحاد",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...aqeedahBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "عقیده",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...adyanBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "ادیان",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...maqabehBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "مکاتب فکری",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...fraqBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "فرق",
        href: `/books/${slugify(b.data.title)}`,
    })),
    ...daavatBooks.map((b) => ({
        title: b.data.title,
        author: b.data.author,
        translator: b.data.translator || "",
        description: b.data.description || "",
        category: "دعوت",
        href: `/books/${slugify(b.data.title)}`,
    })),
];
---

<!DOCTYPE html>

<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

<title>{title}</title>

<meta name="description" content={description} />

</head>

<body>

<Header searchIndex={searchIndex} />

<main class="container">

<div class="disclaimer">
معرفی آثار به‌معنای تأیید محتوای آن‌ها نیست.
</div>

<slot />

</main>

 <script is:inline>

const savedTheme = localStorage.getItem("theme");

if(savedTheme === "dark"){
document.documentElement.classList.add("dark");
}

const setHeaderOffset = () => {
    const header = document.querySelector("header");
    const main = document.querySelector("main");
    if (header && main) {
        const isMobile = window.innerWidth <= 900;
        const bottomNavHeight = isMobile ? 90 : 0;
        main.style.paddingTop = (header.offsetHeight + 20) + "px";
        main.style.paddingBottom = bottomNavHeight + "px";
    }
};
if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setHeaderOffset);
} else {
    setHeaderOffset();
}
window.addEventListener("resize", setHeaderOffset);

</script>

</body>

</html>

<style lang="scss">

html{
background:var(--bg);
}

body{
min-height:100vh;
}

main{
min-height:100vh;
padding:30px 0;
}

@media(max-width:900px){
main{
height:auto;
padding-top:30px;
padding-bottom:80px;
}
}

.disclaimer{
margin-top:20px;
margin-left:0;
margin-right:auto;
padding:12px 18px;
background:rgba(180,30,50,0.08);
border:1.5px dashed #b41e32;
border-radius:12px;
font-size:13px;
color:#b41e32;
line-height:1.8;
max-width:fit-content;
}

</style>
