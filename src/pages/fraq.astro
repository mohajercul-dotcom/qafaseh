---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const books = (await getCollection("fraq")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <div class="page-icon">
        <img class="icon-light" src="/icons/feraq-l.svg" alt="کتاب‌های فرق" />
        <img class="icon-dark" src="/icons/feraq-d.svg" alt="کتاب‌های فرق" />
    </div>

    <p>تاریخ اندیشه اسلامی با پیدایش فرقه‌های گوناگون همراه بوده است. کتاب‌های این بخش به نقد، بررسی و رد باورها، مبانی و پیشینه این جریان‌ها می‌پردازند.</p>

</section>

<section class="books">

    {
        books.map((book) => (
            <a class="book-card" href={`/books/${slugify(book.data.title)}`}>

                <h3>{book.data.title}</h3>

                <p class="author">نویسنده: {book.data.author}</p>

                <p class="desc">{book.data.description}</p>

                <div class="meta">
                    <span>{book.data.publisher}</span>
                    <span>{book.data.year}</span>
                </div>

            </a>
        ))
    }

</section>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:14px;
color:var(--gray);
}
}

.page-icon{
position:relative;
display:inline-flex;
width:min(280px,64%);
aspect-ratio:18/4.27;
margin:0 auto;
}

.page-icon img{
position:absolute;
inset:0;
width:100%;
height:100%;
margin:auto;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

.icon-light{
opacity:1;
transform:scale(1);
}

.icon-dark{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-light{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-dark{
opacity:1;
transform:scale(1);
}

.books{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
padding:20px 0 40px;
}

.book-card{
display:block;
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
text-decoration:none;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
font-size:17px;
margin-bottom:10px;
}

.author{
color:var(--accent);
font-size:13px;
margin-bottom:8px;
}

.desc{
color:var(--gray);
font-size:13px;
line-height:1.8;
margin-bottom:14px;
}

.meta{
display:flex;
justify-content:space-between;
color:var(--gray);
font-size:12px;
border-top:1px solid var(--border);
padding-top:12px;
}
}

@media(max-width:900px){
.books{
grid-template-columns:1fr;
}

.page-icon{
width:min(220px,70%);
}
}

</style>
