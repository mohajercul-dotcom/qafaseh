---
import MainLayout from "../../layouts/MainLayout.astro";
import BookCard from "../../components/BookCard.astro";
import TagFilter from "../../components/TagFilter.astro";
import { getCollection } from "astro:content";
import { slugify, normalizeAuthor } from "../../lib/books.js";

const collections = [
    { name: "shiite", label: "شیعه" },
    { name: "atheism", label: "الحاد" },
    { name: "aqeedah", label: "عقیده" },
    { name: "adyan", label: "ادیان" },
    { name: "maqabeh", label: "مکاتب فکری" },
    { name: "fraq", label: "فرقه‌ها" },
    { name: "daavat", label: "دعوت" },
];

const allBooks = await Promise.all(
    collections.map(async (c) => ({ label: c.label, books: await getCollection(c.name) }))
);

const names = new Set();
for (const { books } of allBooks) {
    for (const book of books) {
        names.add(normalizeAuthor(book.data.author));
    }
}

export async function getStaticPaths() {
    const collections = [
        { name: "shiite", label: "شیعه" },
        { name: "atheism", label: "الحاد" },
        { name: "aqeedah", label: "عقیده" },
        { name: "adyan", label: "ادیان" },
        { name: "maqabeh", label: "مکاتب فکری" },
        { name: "fraq", label: "فرقه‌ها" },
        { name: "daavat", label: "دعوت" },
    ];

    const names = new Set();
    const allBooks = await Promise.all(
        collections.map(async (c) => ({ label: c.label, books: await getCollection(c.name) }))
    );
    for (const { books } of allBooks) {
        for (const book of books) {
            names.add(normalizeAuthor(book.data.author));
        }
    }

    return [...names].map((name) => ({
        params: { slug: slugify(name) },
        props: { name },
    }));
}

const { name } = Astro.props;

const groups = allBooks
    .map(({ label, books }) => ({
        label,
        books: books.filter((book) => normalizeAuthor(book.data.author) === name),
    }))
    .filter((group) => group.books.length > 0);

const allBooksForAuthor = groups.flatMap((group) =>
    group.books.map((book) => ({ ...book, category: group.label }))
);
const total = allBooksForAuthor.length;
---

<MainLayout>

<section class="author-header">

    <h1>{name}</h1>

    <p class="stats">
        {groups.map((group) => (
            <span class="badge">{group.label}: {group.books.length}</span>
        ))}
        <span class="badge total">مجموع: {total} کتاب</span>
    </p>

</section>

<TagFilter tags={collections.map((c) => c.label)} gridId="books-author" byCategory />
<div class="books" id="books-author" data-cols="3">
    {allBooksForAuthor.map((book) => (
        <div class="book-item" data-cat={book.category}>
            <BookCard
                title={book.data.title}
                author={book.data.author}
                description={book.data.description}
                publisher={book.data.publisher}
                year={book.data.year}
                language={book.data.language}
                href={`/books/${slugify(book.data.title)}`}
                tags={book.data.tags || []}
            />
        </div>
    ))}
</div>

<script>
import { initAllGrids } from "../../lib/bookGrid.js";
import { initBookFilter } from "../../lib/bookFilter.js";
initAllGrids();
initBookFilter();
window.addEventListener("resize", initAllGrids);
</script>

</MainLayout>

<style lang="scss">

.author-header{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

.stats{
display:flex;
justify-content:center;
gap:12px;
margin-top:16px;
flex-wrap:wrap;
}

.badge{
padding:6px 14px;
border-radius:20px;
font-size:13px;
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.badge.total{
background:var(--card);
border:1px solid var(--border);
color:var(--text);
}
}

.books{
display:flex;
gap:16px;
padding:20px 0 40px;
opacity:0;
transition:opacity .2s;

&.ready{
opacity:1;
}
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
.books{
flex-direction:column;
}
}

</style>
