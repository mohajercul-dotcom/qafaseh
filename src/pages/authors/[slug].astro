---
import MainLayout from "../../layouts/MainLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify, normalizeAuthor } from "../../lib/books.js";

export async function getStaticPaths() {
    const shiiteBooks = await getCollection("shiite");
    const atheismBooks = await getCollection("atheism");

    const names = new Set();
    for (const book of [...shiiteBooks, ...atheismBooks]) {
        names.add(normalizeAuthor(book.data.author));
    }

    return [...names].map((name) => ({
        params: { slug: slugify(name) },
        props: { name },
    }));
}

const { slug } = Astro.params;
const { name } = Astro.props;

const shiiteBooks = (await getCollection("shiite")).filter(
    (book) => normalizeAuthor(book.data.author) === name
);
const atheismBooks = (await getCollection("atheism")).filter(
    (book) => normalizeAuthor(book.data.author) === name
);
---

<MainLayout>

<section class="author-header">

    <h1>{name}</h1>

    <p class="stats">
        <span class="badge shiite">شیعه: {shiiteBooks.length}</span>
        <span class="badge atheism">الحاد: {atheismBooks.length}</span>
        <span class="badge total">مجموع: {shiiteBooks.length + atheismBooks.length} کتاب</span>
    </p>

</section>

{
    shiiteBooks.length > 0 && (
        <section class="group">

            <h2>کتاب‌های شیعه</h2>

            <div class="books">
                {shiiteBooks.map((book) => (
                    <BookCard
                        title={book.data.title}
                        author={book.data.author}
                        description={book.data.description}
                        publisher={book.data.publisher}
                        year={book.data.year}
                        language={book.data.language}
                        href={`/books/${slugify(book.data.title)}`}
                    />
                ))}
            </div>

        </section>
    )
}

{
    atheismBooks.length > 0 && (
        <section class="group">

            <h2>کتاب‌های الحاد</h2>

            <div class="books">
                {atheismBooks.map((book) => (
                    <BookCard
                        title={book.data.title}
                        author={book.data.author}
                        description={book.data.description}
                        publisher={book.data.publisher}
                        year={book.data.year}
                        language={book.data.language}
                        href={`/books/${slugify(book.data.title)}`}
                    />
                ))}
            </div>

        </section>
    )
}

</MainLayout>

<style lang="scss">

.author-header{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

.stats{
display:flex;
justify-content:center;
gap:12px;
margin-top:16px;
flex-wrap:wrap;
}

.badge{
padding:6px 14px;
border-radius:20px;
font-size:13px;
}

.shiite{
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.atheism{
background:color-mix(in srgb, var(--gray) 18%, transparent);
color:var(--gray);
}

.total{
background:var(--card);
border:1px solid var(--border);
color:var(--text);
}
}

.group{
padding:10px 0 30px;

h2{
font-size:22px;
margin-bottom:16px;
padding-bottom:10px;
border-bottom:1px solid var(--border);
}
}

.books{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
align-items:start;
}

@media(max-width:900px){
.books{
grid-template-columns:1fr;
}
}

</style>
