---
import MainLayout from "../../layouts/MainLayout.astro";
import BookCard from "../../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify, normalizeAuthor } from "../../lib/books.js";

export async function getStaticPaths() {
    const shiiteBooks = await getCollection("shiite");
    const atheismBooks = await getCollection("atheism");

    const names = new Set();
    for (const book of [...shiiteBooks, ...atheismBooks]) {
        names.add(normalizeAuthor(book.data.author));
    }

    return [...names].map((name) => ({
        params: { slug: slugify(name) },
        props: { name },
    }));
}

const { slug } = Astro.params;
const { name } = Astro.props;

const shiiteBooks = (await getCollection("shiite")).filter(
    (book) => normalizeAuthor(book.data.author) === name
);
const atheismBooks = (await getCollection("atheism")).filter(
    (book) => normalizeAuthor(book.data.author) === name
);
---

<MainLayout>

<section class="author-header">

    <h1>{name}</h1>

    <p class="stats">
        <span class="badge shiite">شیعه: {shiiteBooks.length}</span>
        <span class="badge atheism">الحاد: {atheismBooks.length}</span>
        <span class="badge total">مجموع: {shiiteBooks.length + atheismBooks.length} کتاب</span>
    </p>

</section>

{
    shiiteBooks.length > 0 && (
        <section class="group">

            <h2>کتاب‌های شیعه</h2>

            <div class="books" id="books-shiite" data-cols="3">
                {shiiteBooks.map((book) => (
                    <div class="book-item">
                        <BookCard
                            title={book.data.title}
                            author={book.data.author}
                            description={book.data.description}
                            publisher={book.data.publisher}
                            year={book.data.year}
                            language={book.data.language}
                            href={`/books/${slugify(book.data.title)}`}
                        />
                    </div>
                ))}
            </div>

        </section>
    )
}

{
    atheismBooks.length > 0 && (
        <section class="group">

            <h2>کتاب‌های الحاد</h2>

            <div class="books" id="books-atheism" data-cols="3">
                {atheismBooks.map((book) => (
                    <div class="book-item">
                        <BookCard
                            title={book.data.title}
                            author={book.data.author}
                            description={book.data.description}
                            publisher={book.data.publisher}
                            year={book.data.year}
                            language={book.data.language}
                            href={`/books/${slugify(book.data.title)}`}
                        />
                    </div>
                ))}
            </div>

        </section>
    )
}

<script>
function layoutGrid(gridId) {
const grid = document.getElementById(gridId);
if (!grid) return;

const items = Array.from(grid.querySelectorAll(".book-item"));
if (items.length === 0) return;

const w = window.innerWidth;
const cols = w > 900 ? 3 : w > 600 ? 2 : 1;

grid.innerHTML = "";

const columns = [];
for (let i = 0; i < cols; i++) {
const col = document.createElement("div");
col.className = "book-col";
columns.push(col);
}

items.forEach((item, i) => {
columns[i % cols].appendChild(item);
});

columns.forEach(col => grid.appendChild(col));
}

function layoutAll() {
layoutGrid("books-shiite");
layoutGrid("books-atheism");
}

layoutAll();
window.addEventListener("resize", layoutAll);
</script>

</MainLayout>

<style lang="scss">

.author-header{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

.stats{
display:flex;
justify-content:center;
gap:12px;
margin-top:16px;
flex-wrap:wrap;
}

.badge{
padding:6px 14px;
border-radius:20px;
font-size:13px;
}

.shiite{
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.atheism{
background:color-mix(in srgb, var(--gray) 18%, transparent);
color:var(--gray);
}

.total{
background:var(--card);
border:1px solid var(--border);
color:var(--text);
}
}

.group{
padding:10px 0 30px;

h2{
font-size:22px;
margin-bottom:16px;
padding-bottom:10px;
border-bottom:1px solid var(--border);
}
}

.books{
display:flex;
gap:16px;
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
.books{
flex-direction:column;
}
}

</style>
