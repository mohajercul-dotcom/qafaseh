---
import MainLayout from "../layouts/MainLayout.astro";
import TagFilter from "../components/TagFilter.astro";
import { getCollection } from "astro:content";
import { slugify, normalizeAuthor } from "../lib/books.js";

const collections = [
    { name: "shiite", label: "شیعه" },
    { name: "atheism", label: "الحاد" },
    { name: "aqeedah", label: "عقیده" },
    { name: "adyan", label: "ادیان" },
    { name: "maqabeh", label: "مکاتب فکری" },
    { name: "fraq", label: "فرقه‌ها" },
    { name: "daavat", label: "دعوت" },
];

const allBooks = await Promise.all(
    collections.map(async (c) => ({ label: c.label, books: await getCollection(c.name) }))
);

const authors = new Map();

for (const { label, books } of allBooks) {
    for (const book of books) {
        const name = normalizeAuthor(book.data.author);
        const entry = authors.get(name) || { name, counts: {}, total: 0 };
        entry.counts[label] = (entry.counts[label] || 0) + 1;
        entry.total++;
        authors.set(name, entry);
    }
}

const authorList = [...authors.values()].sort((a, b) =>
    a.name.localeCompare(b.name, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <div class="page-icon">
        <img class="icon-light" src="/icons/nevisande-l.svg" alt="نویسندگان" />
        <img class="icon-dark" src="/icons/nevisande-d.svg" alt="نویسندگان" />
    </div>

    <p>این بخش به معرفی نویسندگانی اختصاص دارد که آثارشان در موضوعات هفت‌گانه قفسه گردآوری شده است. برای هر نویسنده، معرفی کوتاه و فهرست کتاب‌های او به‌همراه شمار آثارش در هر موضوع ارائه می‌شود.</p>

</section>

<TagFilter tags={collections.map((c) => c.label)} gridId="authors-grid" byCategory />

<section class="authors" id="authors-grid">

    {
        authorList.map((author) => (
            <a
                class="author-card"
                href={`/authors/${slugify(author.name)}`}
                data-cat={Object.keys(author.counts).filter((label) => author.counts[label] > 0).join(",")}
            >

                <h3>{author.name}</h3>

                <div class="counts">
                    {Object.entries(author.counts).filter(([, count]) => count > 0).map(([label, count]) => (
                        <span class="count">{label}: {count}</span>
                    ))}
                    <span class="total">مجموع: {author.total}</span>
                </div>

            </a>
        ))
    }

</section>

<script>
import { initBookFilter } from "../lib/bookFilter.js";
document.addEventListener("astro:page-load", initBookFilter);
</script>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:14px;
color:var(--gray);
}
}

.page-icon{
position:relative;
display:inline-flex;
width:min(280px,64%);
aspect-ratio:18/4.27;
margin:0 auto;
}

.page-icon img{
position:absolute;
inset:0;
width:100%;
height:100%;
margin:auto;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

.icon-light{
opacity:1;
transform:scale(1);
}

.icon-dark{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-light{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-dark{
opacity:1;
transform:scale(1);
}

.authors{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
padding:20px 0 40px;
}

.author-card{
display:block;
background:var(--card);
border:1px solid var(--border);
border-radius:18px;
padding:22px;
text-decoration:none;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
font-size:17px;
margin-bottom:14px;
}

.counts{
display:flex;
gap:10px;
flex-wrap:wrap;
font-size:12px;

.count{
padding:4px 10px;
border-radius:20px;
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

.total{
color:var(--text);
font-weight:700;
align-self:center;
}
}
}

@media(max-width:900px){
.authors{
grid-template-columns:1fr;
}

.page-icon{
width:min(220px,70%);
}
}

</style>
