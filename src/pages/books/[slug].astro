---
import MainLayout from "../../layouts/MainLayout.astro";
import BookCover from "../../components/BookCover.astro";
import ShareButton from "../../components/ShareButton.astro";
import TextSizeToggle from "../../components/TextSizeToggle.astro";
import { getCollection, render } from "astro:content";
import { slugify, normalizeAuthor, shortCode } from "../../lib/books.js";
import { toPersian } from "../../lib/number.ts";

export async function getStaticPaths() {
    const shiiteBooks = await getCollection("shiite");
    const atheismBooks = await getCollection("atheism");
    const aqeedahBooks = await getCollection("aqeedah");
    const adyanBooks = await getCollection("adyan");
    const maqabehBooks = await getCollection("maqabeh");
    const fraqBooks = await getCollection("fraq");
    const daavatBooks = await getCollection("daavat");

    const all = [
        ...shiiteBooks.map((b) => ({ ...b, category: "shiite" })),
        ...atheismBooks.map((b) => ({ ...b, category: "atheism" })),
        ...aqeedahBooks.map((b) => ({ ...b, category: "aqeedah" })),
        ...adyanBooks.map((b) => ({ ...b, category: "adyan" })),
        ...maqabehBooks.map((b) => ({ ...b, category: "maqabeh" })),
        ...fraqBooks.map((b) => ({ ...b, category: "fraq" })),
        ...daavatBooks.map((b) => ({ ...b, category: "daavat" })),
    ];

    return all.flatMap((book) => {
        const persian = slugify(book.data.title);
        const code = shortCode(book.id + book.data.title);
        return [
            { params: { slug: persian }, props: { book, mode: "page" } },
            { params: { slug: code }, props: { book, mode: "redirect" } },
            { params: { slug: book.id }, props: { book, mode: "redirect" } },
        ];
    });
}

const { book, mode = "page" } = Astro.props;
const category = book.category;
const canonicalSlug = slugify(book.data.title);
const canonicalUrl = `/books/${canonicalSlug}`;
const shortSlug = shortCode(book.id + book.data.title);
const siteBase = import.meta.env.SITE || Astro.url.origin;
const shortUrl = new URL(`/books/${shortSlug}`, siteBase).href;
const siteUrl = siteBase + canonicalUrl;

const { Content } = await render(book);

const firstParagraph = (() => {
    if (!book.body) return book.data.description || "";
    const paragraphs = book.body.split(/\n\n+/).filter(p => p.trim() && !p.trim().startsWith("#") && !p.trim().startsWith("---"));
    const first = paragraphs[0] || "";
    return first.replace(/[#*_`~\[\]]/g, "").replace(/\^\d+/g, "").replace(/https?:\/\/[^\s)]+/g, "").trim();
})();
---

{
    mode === "redirect" ? (
        <html lang="fa" dir="rtl">
            <head>
                <meta charset="UTF-8" />
                <meta name="viewport" content="width=device-width, initial-scale=1.0" />
                <title>{book.data.title} — قفسه</title>
                <link rel="canonical" href={canonicalUrl} />
                <meta http-equiv="refresh" content={`0; url=${canonicalUrl}`} />
                <script is:inline data-url={canonicalUrl}>
                    const el = document.currentScript;
                    if (el) {
                        window.location.replace(el.dataset.url);
                    }
                </script>
            </head>
            <body style="margin:0;display:flex;align-items:center;justify-content:center;min-height:100vh;background:#faf7f1;font-family:sans-serif;text-align:center">
                <div>
                    <p>در حال انتقال به صفحه کتاب…</p>
                    <a href={canonicalUrl} style="color:#B0651F">{book.data.title}</a>
                </div>
            </body>
        </html>
    ) : (
        <MainLayout>

<div class="book-layout">

    <section class="book-main">

        <div class="title-row">
            <h1>{book.data.title}</h1>
            <TextSizeToggle target=".content" />
        </div>

        <article class="content">
            <Content />
        </article>

        <div class="actions-row">
            <ShareButton title={book.data.title} author={book.data.author} excerpt={firstParagraph} url={siteUrl} shortUrl={shortUrl} />

            <a class="author-btn" href={`/authors/${slugify(book.data.author)}`}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
                    <circle cx="12" cy="7" r="4"/>
                </svg>
                <span>کتاب‌های دیگر {book.data.author}</span>
            </a>
        </div>

    </section>

    <aside class="book-side">

        <BookCover
            title={book.data.title}
            author={book.data.author}
            category={category}
            cover={book.data.cover}
        />

        <div class="specs">
            <div class="spec">
                <span class="spec-label">نویسنده</span>
                <span class="spec-value">{book.data.author}</span>
            </div>
            {book.data.translator && (
                <div class="spec">
                    <span class="spec-label">مترجم</span>
                    <span class="spec-value">{book.data.translator}</span>
                </div>
            )}
            {book.data.volumes && (
                <div class="spec">
                    <span class="spec-label">جلد</span>
                    <span class="spec-value">{toPersian(book.data.volumes)} جلد</span>
                </div>
            )}
            {book.data.pages && (
                <div class="spec">
                    <span class="spec-label">صفحات</span>
                    <span class="spec-value">{toPersian(book.data.pages)} صفحه</span>
                </div>
            )}
            {book.data.language && (
                <div class="spec">
                    <span class="spec-label">زبان</span>
                    <span class="spec-value">{book.data.language}</span>
                </div>
            )}
        </div>

        <div class="download-box">

            <a class="download-btn" href={book.data.download || "#"} target="_blank" rel="noopener">
                <span class="dl-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/>
                        <polyline points="7 10 12 15 17 10"/>
                        <line x1="12" y1="15" x2="12" y2="3"/>
                    </svg>
                </span>
                <span class="dl-text">
                    <strong>دانلود کتاب</strong>
                    <small>{book.data.format || "PDF"} — از کانال تلگرام</small>
                </span>
            </a>

        </div>

    </aside>

</div>


        </MainLayout>
    )
}

<script is:inline>
const syncHeight = () => {
    const layout = document.querySelector(".book-layout");
    const side = document.querySelector(".book-side");
    const content = document.querySelector(".book-main .content");
    if (!layout || !side || !content) return;
    if (window.innerWidth <= 1000) {
        content.style.maxHeight = "";
        return;
    }
    const main = document.querySelector(".book-main");
    const titleRow = document.querySelector(".book-main .title-row");
    const shareBlock = document.querySelector(".book-main .share-block");
    const titleH = titleRow ? titleRow.offsetHeight : 0;
    const shareH = shareBlock ? shareBlock.offsetHeight + 18 : 0;
    const sideH = side.offsetHeight;
    const maxH = sideH - titleH - shareH;
    content.style.maxHeight = maxH + "px";
};
window.addEventListener("load", syncHeight);
window.addEventListener("resize", syncHeight);
</script>

<script is:inline>
const setupFootnotes = () => {
    const refs = document.querySelectorAll(".content a[data-footnote-ref]");
    if (!refs.length) return;

    const toFa = (s) => s.replace(/\d/g, (d) => String.fromCharCode(d.charCodeAt(0) + 1728));

    const localizeDigits = (node) => {
        if (node && node.textContent) {
            node.textContent = toFa(node.textContent);
        }
    };

    refs.forEach((ref) => localizeDigits(ref));

    const footnoteSection = document.querySelector(".content section[data-footnotes]");
    if (footnoteSection) {
        footnoteSection.querySelectorAll("li[id^='user-content-fn-'], a[data-footnote-backref]").forEach((el) => {
            localizeDigits(el);
            const numSpan = el.querySelector(".footnote-number");
            if (numSpan) localizeDigits(numSpan);
        });
    }

    let tooltip = document.querySelector(".fn-tooltip");
    if (!tooltip) {
        tooltip = document.createElement("div");
        tooltip.className = "fn-tooltip";
        tooltip.innerHTML =
            "<span class='fn-text'></span>" +
            "<div class='fn-footer'><button class='fn-copy' type='button'>کپی</button></div>";
        document.body.appendChild(tooltip);
    }

    const fnText = tooltip.querySelector(".fn-text");
    const copyBtn = tooltip.querySelector(".fn-copy");
    const arrow = document.createElement("span");
    arrow.className = "fn-arrow";
    tooltip.appendChild(arrow);

    const textOf = (ref) => {
        const id = ref.id.replace("fnref-", "fn-");
        const li = document.getElementById(id);
        if (!li) return "";
        let t = li.textContent;
        const backref = li.querySelector("a[data-footnote-backref]");
        if (backref) {
            t = t.replace(backref.textContent, "").trim();
        }
        t = t.replace(/\s*↩\s*$/, "").trim();
        return t;
    };

    const hideTooltip = () => {
        tooltip.classList.remove("show");
        refs.forEach((r) => r.classList.remove("active"));
    };

    const showTooltip = (ref) => {
        fnText.textContent = textOf(ref);
        copyBtn.textContent = "کپی";
        tooltip.classList.add("show");

        const rect = ref.getBoundingClientRect();
        const tooltipW = tooltip.offsetWidth;
        const tooltipH = tooltip.offsetHeight;
        const left = Math.max(12, Math.min(rect.left + rect.width / 2 - tooltipW / 2, window.innerWidth - tooltipW - 12));
        const top = rect.top - tooltipH - 10;
        tooltip.style.left = left + "px";
        tooltip.style.top = top + "px";

        arrow.style.left = Math.max(8, Math.min(rect.left + rect.width / 2 - left - 7, tooltipW - 16)) + "px";
    };

    let activeRef = null;
    let fullText = "";

    refs.forEach((ref) => {
        ref.addEventListener("click", (e) => {
            e.preventDefault();
            if (activeRef === ref && tooltip.classList.contains("show")) {
                hideTooltip();
                activeRef = null;
            } else {
                if (activeRef) activeRef.classList.remove("active");
                hideTooltip();
                showTooltip(ref);
                ref.classList.add("active");
                activeRef = ref;
                fullText = textOf(ref);
            }
        });
    });

    copyBtn.onclick = (e) => {
        e.stopPropagation();
        navigator.clipboard.writeText(fullText).then(() => {
            copyBtn.textContent = "کپی شد ✓";
            setTimeout(() => (copyBtn.textContent = "کپی"), 1500);
        });
    };

    document.addEventListener("click", (e) => {
        if (!e.target.closest(".fn-tooltip") && !e.target.closest("[data-footnote-ref]")) {
            hideTooltip();
            activeRef = null;
        }
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") {
            hideTooltip();
            activeRef = null;
        }
    });
    window.addEventListener("scroll", hideTooltip, true);
};

if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupFootnotes);
} else {
    setupFootnotes();
}
</script>

<style lang="scss" is:global>

.fn-tooltip{
position:fixed;
z-index:1000;
min-width:240px;
max-width:420px;
background:color-mix(in srgb, var(--card) 92%, var(--accent));
color:var(--text);
border:1px solid var(--border);
border-radius:14px;
overflow:hidden;
box-shadow:0 18px 48px rgba(0,0,0,.28);
opacity:0;
visibility:hidden;
pointer-events:none;
transform:translateY(8px) scale(.98);
transition:opacity .18s ease, transform .18s ease, visibility .18s;

&.show{
opacity:1;
visibility:visible;
pointer-events:auto;
transform:translateY(0) scale(1);
}

.fn-text{
display:block;
padding:10px 14px 6px;
font-size:12.5px;
line-height:1.9;
font-weight:500;
color:var(--gray);
text-align:right;
}

.fn-footer{
display:flex;
justify-content:flex-end;
padding:4px 14px 12px;
}

.fn-copy{
background:color-mix(in srgb, var(--accent) 12%, transparent);
color:var(--accent);
border:1px solid color-mix(in srgb, var(--accent) 35%, transparent);
border-radius:8px;
padding:5px 16px;
font-size:11px;
font-family:inherit;
font-weight:600;
cursor:pointer;
transition:filter .2s ease, background .2s ease;

&:hover{
filter:brightness(1.1);
background:color-mix(in srgb, var(--accent) 18%, transparent);
}
}

.fn-arrow{
position:absolute;
bottom:-6px;
left:50%;
width:12px;
height:12px;
background:var(--card);
border-right:1px solid var(--border);
border-bottom:1px solid var(--border);
transform:rotate(45deg);
}
}

@media(max-width:900px){
.fn-tooltip{
min-width:180px;
max-width:260px;
}
}

.content a[data-footnote-ref]{
display:inline-flex;
align-items:center;
justify-content:center;
min-width:20px;
height:20px;
margin:0 3px;
padding:0 4px;
border-radius:50%;
background:color-mix(in srgb, var(--accent) 12%, transparent);
color:var(--accent);
font-size:11px;
font-weight:800;
line-height:1;
text-decoration:none;
cursor:pointer;
user-select:none;
vertical-align:super;
transition:background .2s ease, color .2s ease, transform .15s ease;

&:hover{
background:var(--accent);
color:#fff;
transform:scale(1.08);
}
}

.content a[data-footnote-ref].active{
background:var(--accent);
color:#fff;
}

.content section[data-footnotes]{
display:none;
}

.badge{
display:inline-block;
padding:6px 18px;
border-radius:20px;
font-size:13px;
margin-bottom:18px;

&.shiite{
background:color-mix(in srgb, var(--accent) 15%, transparent);
color:var(--accent);
}

&.atheism{
background:color-mix(in srgb, var(--gray) 18%, transparent);
color:var(--gray);
}
}

.book-layout{
display:grid;
grid-template-columns:minmax(0, 620px) 300px;
gap:28px;
padding:30px 0 20px;
align-items:start;
justify-content:center;
}

.book-main{
display:flex;
flex-direction:column;
min-width:0;

.title-row{
display:flex;
align-items:flex-start;
justify-content:space-between;
gap:16px;
margin-bottom:18px;

h1{
font-size:32px;
font-weight:900;
line-height:1.5;
flex:1;
}

:global(.text-size){
flex-shrink:0;
margin-top:6px;
}
}

.content{
min-height:0;
overflow-y:auto;
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:28px;
line-height:2.2;
font-size:15px;
text-align:justify;
text-justify:inter-word;
transition:background .6s ease, border-color .6s ease;
margin-bottom:10px;
}

}

.book-side{
position:sticky;
top:24px;
display:flex;
flex-direction:column;
gap:20px;
}

.download-box{
display:flex;
flex-direction:column;
gap:10px;
}

.specs{
background:var(--card);
border:1px solid var(--border);
border-radius:16px;
padding:6px 18px;
transition:background .6s ease, border-color .6s ease;

.spec{
display:flex;
justify-content:space-between;
align-items:center;
padding:11px 0;
gap:12px;

&:not(:last-child){
border-bottom:1px dashed var(--border);
}

.spec-label{
font-size:12px;
color:var(--gray);
}

.spec-value{
font-size:13px;
font-weight:500;
color:var(--text);
}
}
}

.download-btn{
display:flex;
align-items:center;
justify-content:center;
gap:12px;
width:100%;
background:var(--accent);
color:#fff;
padding:16px 20px;
border-radius:14px;
text-decoration:none;
box-shadow:0 8px 24px color-mix(in srgb, var(--accent) 35%, transparent);
transition:transform .25s ease, box-shadow .25s ease, filter .25s ease;

&:hover{
transform:translateY(-3px);
box-shadow:0 14px 32px color-mix(in srgb, var(--accent) 45%, transparent);
filter:brightness(1.05);
}

.dl-icon svg{
width:24px;
height:24px;
}

.dl-text{
display:flex;
flex-direction:column;
align-items:flex-start;
line-height:1.4;

strong{
font-size:15px;
}

small{
font-size:11px;
opacity:.8;
}
}
}

.volumes-note{
text-align:center;
color:var(--gray);
font-size:12px;
}

.actions-row{
display:flex;
align-items:center;
gap:12px;
margin-top:12px;
}

.author-btn{
display:inline-flex;
align-items:center;
gap:8px;
padding:10px 18px;
border-radius:12px;
border:1px solid var(--border);
background:var(--card);
color:var(--text);
font-size:13px;
font-weight:500;
text-decoration:none;
transition:background .3s ease, border-color .3s ease, color .3s ease;

svg{
width:18px;
height:18px;
}

&:hover{
background:var(--accent);
border-color:var(--accent);
color:#fff;
}
}

@media(max-width:1000px){

.book-layout{
grid-template-columns:1fr;
}

.book-side{
position:static;
max-width:300px;
margin:0 auto;
}
}

@media(max-width:900px){

.book-main h1{
font-size:26px;
text-align:center;
}

.content{
margin-bottom:7px;
}

.download-btn{
width:auto;
max-width:260px;
margin:0 auto;
}
}

</style>
