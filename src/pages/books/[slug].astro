---
import BookPage from "../../components/pages/BookPage.astro";
import { bookPaths } from "../../lib/paths.js";

export function getStaticPaths() {
    return bookPaths().then((paths) => paths.map((p) => ({ ...p, props: { ...p.props, locale: "fa" } })));
}

const { book, mode, locale } = Astro.props;
---
<BookPage book={book} mode={mode} locale={locale} />
