---
import "../styles/global.scss";
import ChevronLeftIcon from "../components/icons/ChevronLeftIcon.astro";
import GlobeIcon from "../components/icons/GlobeIcon.astro";
import SendIcon from "../components/icons/SendIcon.astro";
import InstagramIcon from "../components/icons/InstagramIcon.astro";
import ShareIcon from "../components/icons/ShareIcon.astro";
import DownloadIcon from "../components/icons/DownloadIcon.astro";

export async function getStaticPaths() {
  const allModules = import.meta.glob('../data/*.md', { eager: true });
  const modules = Object.fromEntries(Object.entries(allModules).filter(([k, v]) => v.frontmatter?.slug));
  return Object.values(modules).map((mod: any) => ({
    params: { slug: mod.frontmatter.slug },
    props: { project: mod },
  }));
}

const { project } = Astro.props;
const { frontmatter, Content } = project;
const p = frontmatter;
const hasPdfs = p.pdfs && p.pdfs.filter((f: any) => f.file).length > 0;
const firstPdf = hasPdfs ? p.pdfs.filter((f: any) => f.file)[0] : null;
const downloadLinks = [
  { key: "telegram", label: "تلگرام", href: p.downloads?.telegram ?? p.telegram },
  { key: "archive", label: "آرشیو", href: p.downloads?.archive ?? p.archive },
  { key: "server", label: "سرور", href: p.downloads?.server ?? p.server },
].filter((link: any) => typeof link.href === "string" && link.href.trim() !== "" && link.href !== "#");
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{p.name}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@200;300;400;900&family=Vazirmatn:wght@300;400;500;700&family=Cairo:wght@400;600;700;900&family=Rubik:wght@300;400;500;700&display=swap" rel="stylesheet">
  </head>
  <body>
    <div class="project-page">
      <div class="project-card">
        <div class="project-toolbar">
          <a href="/" class="back-link" data-tooltip="صفحه اصلی">
            <ChevronLeftIcon class="back-icon" />
            بازگشت
          </a>
          <div class="toolbar-actions">
            <button class="toolbar-btn" id="fontSizeBtn" data-tooltip="تغییر اندازه متن">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M13.06,18.87c0,.21-.11.31-.33.31h-2.7c-.1,0-.19-.03-.25-.1s-.11-.15-.14-.25l-.7-3.17h-3.96l-.7,3.17c-.03.1-.07.19-.14.25-.06.06-.15.1-.25.1H1.2c-.22,0-.33-.1-.33-.31,0-.01,0-.03,0-.04,0-.01,0-.03,0-.06L3.77,6.79c.12-.46.28-.84.5-1.12s.47-.5.76-.65c.29-.15.6-.25.94-.3.33-.05.67-.08,1-.08s.67.03,1,.08.64.15.93.3c.29.15.54.36.76.65.22.28.39.66.5,1.12l2.88,11.98s0,.05,0,.06c0,.01,0,.03,0,.04ZM7.23,7.68c-.03-.1-.05-.18-.08-.22s-.08-.07-.17-.07c-.14,0-.23.1-.27.29l-1.18,5.33h2.88l-1.18-5.33Z"/><path fill="currentColor" d="M23.13,18.79c0,.1-.04.19-.12.27s-.17.12-.27.12h-2.16c-.1,0-.19-.04-.27-.12-.08-.08-.12-.17-.12-.27v-.31c-.37.27-.77.48-1.19.64-.42.15-.92.23-1.5.23-.43,0-.83-.06-1.23-.16-.39-.11-.74-.29-1.05-.55s-.56-.6-.74-1.02c-.19-.42-.28-.95-.28-1.58v-.17c0-1.13.38-1.96,1.13-2.48.75-.52,1.96-.78,3.62-.78h1.04v-.7c0-.55-.13-.91-.39-1.08-.26-.17-.61-.25-1.06-.25-.31,0-.62,0-.94.01-.32,0-.62.02-.91.03-.29.01-.55.03-.78.05-.23.02-.42.04-.58.05h-.1c-.1,0-.19-.03-.25-.08s-.1-.14-.1-.27v-1.56c0-.22.12-.36.37-.43.36-.09.85-.18,1.46-.27.61-.09,1.24-.14,1.88-.14.69,0,1.32.07,1.88.22s1.03.38,1.42.7c.39.32.69.72.9,1.22.21.5.32,1.1.32,1.81v6.9ZM20.06,14.44h-1.1c-.33,0-.61.03-.83.09s-.39.14-.52.26c-.13.12-.22.26-.27.44s-.08.39-.08.62v.17c0,.41.1.68.3.79.2.12.51.17.92.17.3,0,.58-.04.84-.13.26-.08.51-.18.74-.3v-2.13Z"/></svg>
            </button>
            <button class="toolbar-btn" id="printBtn" data-tooltip="پرینت صفحه">
              <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
            </button>
          </div>
        </div>

        <header class="project-header">
          <h1>{p.name}</h1>
          {p.tagline && <p class="project-tagline">{p.tagline}</p>}
        </header>

        <div class="project-content" id={`${p.slug}-content`}>
          <Content />
        </div>

        {downloadLinks.length > 0 && (
          <div class="project-download">
            <div class="download-info">
              <h4>دریافت کتاب</h4>
              <p>نسخه‌های موجود این کتاب را دریافت کنید.</p>
            </div>
            <div class="download-actions">
              {downloadLinks.map((link: any) => (
                <a href={link.href} target="_blank" rel="noopener" class="download-btn" data-download-type={link.key}>
                  <DownloadIcon class="download-icon" />
                  <span>{link.label}</span>
                </a>
              ))}
            </div>
          </div>
        )}

        {hasPdfs && (
          <div class="project-download">
            <div class="download-info">
              <h4>دانلود فایل پروژه</h4>
              <p>فایل معرفی «{p.name}» را دانلود کنید.</p>
            </div>
            <a href={firstPdf.file} download class="download-btn">
              <DownloadIcon class="download-icon" />
              <span>دانلود (PDF)</span>
            </a>
          </div>
        )}

        <div class="project-links">
          {p.links?.site && (
            <a href={p.links.site} target="_blank" rel="noopener" class="project-link" data-tooltip="وبسایت پروژه">
              <GlobeIcon class="pl-icon" />
            </a>
          )}
          {p.links?.telegram && (
            <a href={p.links.telegram} target="_blank" rel="noopener" class="project-link" data-tooltip="کانال تلگرام">
              <SendIcon class="pl-icon" />
            </a>
          )}
          {p.links?.instagram && (
            <a href={p.links.instagram} target="_blank" rel="noopener" class="project-link" data-tooltip="اینستاگرام">
              <InstagramIcon class="pl-icon" />
            </a>
          )}
        </div>

        <div class="project-actions">
          <button class="action-btn" id="shareBtn" data-title={p.name} data-intro={p.intro ? p.intro.split('\n').filter((l: string) => l.trim()).map((l: string) => l.trim()).join('\n') : ''}>
            <ShareIcon class="action-icon" />
            <span>اشتراک‌گذاری</span>
          </button>
        </div>
      </div>
      <button class="scroll-top-btn" id="scrollTopBtn" aria-label="پرش به بالا">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 19V5"/>
          <polyline points="5 12 12 5 19 12"/>
        </svg>
      </button>
    </div>

    <script>
      document.body.classList.add("dark");
      if (window.innerWidth <= 640) {
        document.body.style.overflow = "hidden";
        document.documentElement.style.overflow = "hidden";
      }

      document.getElementById("shareBtn")?.addEventListener("click", function() {
        var title = this.getAttribute("data-title");
        var intro = (this.getAttribute("data-intro") || "")
          .replace(/\\n/g, "\n")
          .replace(/^#(.+)$/gm, "*$1*");
        var url = window.location.href;
        var shareText = intro + "\n\nبرای دیدن ادامه به لینک زیر مراجعه کنید:\n" + url;
        var span = this.querySelector("span");
        if (navigator.share) {
          navigator.share({ text: shareText });
        } else {
          navigator.clipboard.writeText(shareText);
          if (span) span.textContent = "کپی شد!";
          var btn = this;
          setTimeout(function() {
            if (span) span.textContent = "اشتراک‌گذاری";
          }, 2000);
        }
      });

      var fontSizes = [0.85, 1, 1.15, 1.3, 1.4];
      var fontIdx = 1;
      var headingSizes = [1.1, 1.3, 1.5, 1.7, 1.9];
      document.getElementById("fontSizeBtn")?.addEventListener("click", function() {
        fontIdx = (fontIdx + 1) % fontSizes.length;
        var el = document.querySelector(".project-content");
        if (el) el.style.fontSize = fontSizes[fontIdx] + "rem";
        var h2s = document.querySelectorAll(".project-content h2");
        var h3s = document.querySelectorAll(".project-content h3");
        h2s.forEach(function(h) { h.style.fontSize = headingSizes[fontIdx] + "rem"; });
        h3s.forEach(function(h) { h.style.fontSize = (headingSizes[fontIdx] - 0.2) + "rem"; });
      });

      document.getElementById("printBtn")?.addEventListener("click", function() {
        window.print();
      });

      var scrollTopBtn = document.getElementById("scrollTopBtn");
      var projectCard = document.querySelector(".project-card");
      var isMobile = window.innerWidth <= 640;
      if (scrollTopBtn && projectCard) {
        projectCard.addEventListener("scroll", function() {
          var threshold = isMobile ? 10 : 300;
          if (this.scrollTop > threshold) {
            scrollTopBtn.classList.add("visible");
          } else {
            scrollTopBtn.classList.remove("visible");
          }
        });
        scrollTopBtn.addEventListener("click", function() {
          projectCard.scrollTo({ top: 0, behavior: "smooth" });
        });
      }
    </script>
  </body>
</html>
