---
import MainLayout from "../layouts/MainLayout.astro";
import BookCard from "../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const books = (await getCollection("shiite")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <div class="page-icon">
        <img class="icon-light" src="/icons/shia-l.svg" alt="کتاب‌های شیعه" />
        <img class="icon-dark" src="/icons/shia-d.svg" alt="کتاب‌های شیعه" />
    </div>

    <p>کتاب‌هایی درباره تاریخ، عقاید و اندیشه شیعه.</p>

</section>

<div class="books" id="books-shiite" data-cols="3">
    {books.map((book) => (
        <div class="book-item">
            <BookCard
                title={book.data.title}
                author={book.data.author}
                description={book.data.description}
                publisher={book.data.publisher}
                year={book.data.year}
                language={book.data.language}
                href={`/books/${slugify(book.data.title)}`}
            />
        </div>
    ))}
</div>

<script>
import { initAllGrids } from "../lib/bookGrid.js";
initAllGrids();
window.addEventListener("resize", initAllGrids);
</script>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:14px;
color:var(--gray);
}
}

.page-icon{
position:relative;
display:inline-flex;
width:min(280px,64%);
aspect-ratio:18/4.27;
margin:0 auto;
}

.page-icon img{
position:absolute;
inset:0;
width:100%;
height:100%;
margin:auto;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

.icon-light{
opacity:1;
transform:scale(1);
}

.icon-dark{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-light{
opacity:0;
transform:scale(.9);
}

:global(.dark) .icon-dark{
opacity:1;
transform:scale(1);
}

.books{
display:flex;
gap:16px;
padding:20px 0 40px;
opacity:0;
transition:opacity .2s;

&.ready{
opacity:1;
}
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
.books{
flex-direction:column;
}

.page-icon{
width:min(220px,70%);
}
}

</style>
