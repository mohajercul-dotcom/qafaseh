---
import MainLayout from "../layouts/MainLayout.astro";
import BookCard from "../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const books = (await getCollection("shiite")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <h1>کتاب‌های شیعه</h1>

    <p>کتاب‌هایی درباره تاریخ، عقاید و اندیشه شیعه.</p>

</section>

<div class="books" id="books-grid" data-cols="3">
    {books.map((book) => (
        <div class="book-item">
            <BookCard
                title={book.data.title}
                author={book.data.author}
                description={book.data.description}
                publisher={book.data.publisher}
                year={book.data.year}
                language={book.data.language}
                href={`/books/${slugify(book.data.title)}`}
            />
        </div>
    ))}
</div>

<script>
function layoutBooks() {
const grid = document.getElementById("books-grid");
if (!grid) return;

const items = Array.from(grid.querySelectorAll(".book-item"));
const w = window.innerWidth;
const cols = w > 900 ? 3 : w > 600 ? 2 : 1;

grid.innerHTML = "";

const columns = [];
for (let i = 0; i < cols; i++) {
const col = document.createElement("div");
col.className = "book-col";
columns.push(col);
}

items.forEach((item, i) => {
columns[i % cols].appendChild(item);
});

columns.forEach(col => grid.appendChild(col));
}

layoutBooks();
window.addEventListener("resize", layoutBooks);
</script>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:12px;
color:var(--gray);
}
}

#books-grid{
display:flex;
gap:16px;
padding:20px 0 40px;
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
#books-grid{
flex-direction:column;
}
}

</style>
