---
import MainLayout from "../layouts/MainLayout.astro";
import BookCard from "../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const books = (await getCollection("shiite")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <h1>کتاب‌های شیعه</h1>

    <p>کتاب‌هایی درباره تاریخ، عقاید و اندیشه شیعه.</p>

</section>

<section class="books">

    {
        books.map((book) => (
            <BookCard
                title={book.data.title}
                author={book.data.author}
                description={book.data.description}
                publisher={book.data.publisher}
                year={book.data.year}
                language={book.data.language}
                href={`/books/${slugify(book.data.title)}`}
            />
        ))
    }

</section>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:12px;
color:var(--gray);
}
}

.books{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:16px;
padding:20px 0 40px;
}

@media(max-width:900px){
.books{
grid-template-columns:1fr;
}
}

</style>
