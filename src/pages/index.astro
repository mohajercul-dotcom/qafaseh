---
import MainLayout from "../layouts/MainLayout.astro";
import BookCover from "../components/BookCover.astro";
import { getCollection } from "astro:content";
import { statSync } from "node:fs";
import { slugify, normalizeAuthor } from "../lib/books.js";
import { toPersian } from "../lib/number.ts";

const shiiteBooks = await getCollection("shiite");
const atheismBooks = await getCollection("atheism");
const aqeedahBooks = await getCollection("aqeedah");
const adyanBooks = await getCollection("adyan");
const maqabehBooks = await getCollection("maqabeh");
const fraqBooks = await getCollection("fraq");
const daavatBooks = await getCollection("daavat");

const allBooks = [
    ...shiiteBooks.map((b) => ({ ...b, category: "shiite" })),
    ...atheismBooks.map((b) => ({ ...b, category: "atheism" })),
    ...aqeedahBooks.map((b) => ({ ...b, category: "aqeedah" })),
    ...adyanBooks.map((b) => ({ ...b, category: "adyan" })),
    ...maqabehBooks.map((b) => ({ ...b, category: "maqabeh" })),
    ...fraqBooks.map((b) => ({ ...b, category: "fraq" })),
    ...daavatBooks.map((b) => ({ ...b, category: "daavat" })),
];

const totalBooks = allBooks.length;
const authorNames = new Set(allBooks.map((b) => normalizeAuthor(b.data.author)));
const totalAuthors = authorNames.size;
const shiiteCount = shiiteBooks.length;
const atheismCount = atheismBooks.length;
const aqeedahCount = aqeedahBooks.length;
const adyanCount = adyanBooks.length;
const maqabehCount = maqabehBooks.length;
const fraqCount = fraqBooks.length;
const daavatCount = daavatBooks.length;

const newest = [...allBooks].sort((a, b) => {
    const ta = a.data.pubDate || (a.filePath ? statSync(a.filePath).mtime : 0);
    const tb = b.data.pubDate || (b.filePath ? statSync(b.filePath).mtime : 0);
    return new Date(tb) - new Date(ta);
}).slice(0, 5);
const mostRead = [...allBooks].sort((a, b) => (b.data.reads || 0) - (a.data.reads || 0)).slice(0, 5);
const today = allBooks.find((b) => b.data.featured) || newest[0];
---

<MainLayout>

<section class="hero">

    <div class="hero-text">
        <img class="site-logo logo-light" src="/icons/Light.svg" alt="کتاب‌شناسی" />
        <img class="site-logo logo-dark" src="/icons/Dark.svg" alt="کتاب‌شناسی" />
    </div>

</section>

<section class="widgets">

    {
        today && (
            <div class="card today-card">

                <h3>کتاب امروز</h3>

                <a class="today-link" href={`/books/${slugify(today.data.title)}`}>
                    <div class="today-info">
                        <h2>{today.data.title}</h2>
                        <p class="today-author">{today.data.author}</p>
                        {(today.data.caption || today.data.description) && (
                            <p class="today-desc">{today.data.caption || today.data.description}</p>
                        )}
                    </div>
                    <BookCover
                        title={today.data.title}
                        author={today.data.author}
                        category={today.category}
                        cover={today.data.cover}
                    />
                </a>

            </div>
        )
    }

    <div class="card">

        <h3>تازه‌های سایت</h3>

        <div class="card-list">
            {
                newest.map((b) => (
                    <a class="card-link" href={`/books/${slugify(b.data.title)}`}>
                        {b.data.title}
                    </a>
                ))
            }
        </div>

    </div>

    <div class="card">

        <h3>پرخواننده‌ترین</h3>

        <div class="card-list">
            {
                mostRead.map((b, i) => (
                    <a class="card-link ranked" href={`/books/${slugify(b.data.title)}`}>
                        <span class="rank">{[ "۰۱", "۰۲", "۰۳", "۰۴", "۰۵" ][i]}</span>
                        <span>{b.data.title}</span>
                    </a>
                ))
            }
        </div>

    </div>

</section>

<section class="stats-row">

    <div class="card stat">
        <h3>کل کتاب‌ها</h3>
        <strong>{toPersian(totalBooks)}</strong>
    </div>

    <div class="card stat">
        <h3>نویسندگان</h3>
        <strong>{toPersian(totalAuthors)}</strong>
    </div>

    <div class="card stat">
        <h3>کتاب شیعه</h3>
        <strong>{toPersian(shiiteCount)}</strong>
    </div>

    <div class="card stat">
        <h3>کتاب الحاد</h3>
        <strong>{toPersian(atheismCount)}</strong>
    </div>

</section>

</MainLayout>

<style lang="scss">

@font-face{
font-family:"Adobe Arabic";
src:url("/fonts/Adobe arabic shin.woff2") format("woff2");
font-weight:700;
font-style:normal;
font-display:swap;
}

@font-face{
font-family:"Alexandria";
src:url("/fonts/Alexandria-Regular.woff2") format("woff2");
font-weight:400;
font-style:normal;
font-display:swap;
}

@font-face{
font-family:"Alexandria";
src:url("/fonts/Alexandria-Bold.woff2") format("woff2");
font-weight:700;
font-style:normal;
font-display:swap;
}

.hero{
height:200px;
display:flex;
align-items:center;
padding:10px 0;

.hero-text{
position:relative;
width:clamp(120px, 30vw, 250px);
aspect-ratio:432/323;

.site-logo{
width:100%;
height:auto;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
position:absolute;
top:0;
left:0;
}

.logo-light{
opacity:1;
transform:scale(1);
}

.logo-dark{
opacity:0;
transform:scale(.9);
}

:global(.dark) & .logo-light{
opacity:0;
transform:scale(.9);
}

:global(.dark) & .logo-dark{
opacity:1;
transform:scale(1);
}
}
}

@media(max-width:900px){
.hero{
height:auto;
padding:7px 16px;
}

.hero-text{
width:min(92vw,320px);
}

.hero-text .site-logo{
width:clamp(100px, 55vw, 160px);
}
}
}

.widgets{
display:grid;
grid-template-columns:repeat(12,1fr);
gap:16px;
}

.widgets .card{
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:25px;
grid-column:span 4;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
margin-bottom:20px;
background:color-mix(in srgb, var(--accent) 14%, transparent);
color:var(--text);
padding:8px 14px;
border-radius:12px;
border:1px solid color-mix(in srgb, var(--accent) 22%, transparent);
font-size:14px;
font-weight:700;
}
}

.card-list{
display:flex;
flex-direction:column;
}

.card-link{
display:block;
color:var(--text);
text-decoration:none;
padding:11px 4px;
font-size:14px;
transition:color .2s, background .2s ease;
border-radius:10px;

&:not(:last-child){
border-bottom:1px dashed var(--border);
}

&:hover{
color:var(--accent);
background:color-mix(in srgb, var(--accent) 6%, transparent);
}

&.ranked{
display:flex;
align-items:center;
gap:12px;

.rank{
flex-shrink:0;
font-size:12px;
font-weight:700;
color:var(--accent);
background:color-mix(in srgb, var(--accent) 14%, transparent);
min-width:34px;
text-align:center;
padding:3px 6px;
border-radius:8px;
}
}
}

.today-card{
display:flex;
flex-direction:column;

.today-link{
display:flex;
gap:22px;
text-decoration:none;
align-items:stretch;
flex:1;

:global(.cover-photo),
:global(.cover-img){
width:130px;
flex-shrink:0;
order:2;
align-self:flex-start;
}

.today-info{
flex:1;
min-width:0;
display:flex;
flex-direction:column;
order:1;

h2{
font-size:20px;
font-weight:800;
color:var(--text);
line-height:1.6;
margin-bottom:6px;
}

.today-author{
color:var(--accent);
font-size:13px;
font-weight:600;
margin:0 0 10px;
}

.today-desc{
flex:1;
color:var(--gray);
font-size:13px;
line-height:1.9;
margin:0;
text-align:justify;
}
}
}
}

.stats-row{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:16px;
margin-top:30px;
}

.stats-row .card{
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:25px;
text-align:center;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
background:transparent;
border:none;
padding:0;
border-radius:0;
font-size:13px;
margin-bottom:10px;
color:var(--text);
}

strong{
font-size:40px;
color:var(--accent);
}
}

@media(max-width:900px){
.widgets{
grid-template-columns:1fr;

.card{
grid-column:span 1;
}
}

.stats-row{
grid-template-columns:repeat(4,1fr);
gap:8px;

.card{
padding:15px;

strong{
font-size:20px;
}

h3{
font-size:10px;
}
}
}
}

</style>
