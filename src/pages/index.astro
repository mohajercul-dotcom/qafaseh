---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout>

<section class="hero">

    <div class="hero-text">

        <h1>
            جهان کتاب‌ها،
            <span>کشف کنید</span>
        </h1>

        <p>
            معرفی کوتاه و حرفه‌ای کتاب‌ها،
            نویسندگان و اندیشه‌ها در یک آرشیو علمی و مدرن.
        </p>

    </div>

</section>

<section class="widgets">

    <div class="card">

        <h3>کتاب امروز</h3>

        <h2>
            انسان در جستجوی معنا
        </h2>

        <p>
            ویکتور فرانکل
        </p>

    </div>

    <div class="card">

        <h3>تازه‌های سایت</h3>

        <p>
            نقد الحاد مدرن
        </p>

        <p>
            تاریخ تشیع
        </p>

        <p>
            فلسفه دین
        </p>

    </div>

    <div class="card">

        <h3>پرخواننده‌ترین</h3>

        <p>
            ۱ - انسان خردمند
        </p>

        <p>
            ۲ - دنیای سوفی
        </p>

        <p>
            ۳ - الغدیر
        </p>

    </div>

    <div class="card stat">

        <h3>
            کل کتاب‌ها
        </h3>

        <strong>
            1250
        </strong>

    </div>

    <div class="card stat">

        <h3>
            نویسندگان
        </h3>

        <strong>
            430
        </strong>

    </div>

    <div class="card stat">

        <h3>
            کتاب شیعه
        </h3>

        <strong>
            350
        </strong>

    </div>

    <div class="card stat">

        <h3>
            کتاب الحاد
        </h3>

        <strong>
            120
        </strong>

    </div>

</section>

</MainLayout>

<style lang="scss">

.hero{
height:260px;
display:flex;
align-items:center;

.hero-text{
h1{
font-size:55px;
font-weight:900;

span{
color:var(--accent);
}
}

p{
margin-top:20px;
color:var(--gray);
font-size:18px;
}
}
}

.widgets{
display:grid;
grid-template-columns:repeat(12,1fr);
gap:16px;

.card{
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:25px;
grid-column:span 4;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
margin-bottom:20px;
}

p{
color:var(--gray);
margin:8px 0;
}
}

.stat{
grid-column:span 3;
text-align:center;

strong{
font-size:40px;
color:var(--accent);
}
}
}

@media(max-width:900px){
.hero{
height:auto;
padding:40px 0;

.hero-text h1{
font-size:38px;
}
}

.widgets{
grid-template-columns:1fr;

.card,
.stat{
grid-column:auto;
}
}
}

</style>
