---
import MainLayout from "../layouts/MainLayout.astro";
import { getCollection } from "astro:content";
import { statSync } from "node:fs";
import { slugify, normalizeAuthor } from "../lib/books.js";
import { toPersian } from "../lib/number.ts";

const shiiteBooks = await getCollection("shiite");
const atheismBooks = await getCollection("atheism");
const aqeedahBooks = await getCollection("aqeedah");
const adyanBooks = await getCollection("adyan");
const maqabehBooks = await getCollection("maqabeh");
const fraqBooks = await getCollection("fraq");
const daavatBooks = await getCollection("daavat");

const allBooks = [
    ...shiiteBooks.map((b) => ({ ...b, category: "shiite" })),
    ...atheismBooks.map((b) => ({ ...b, category: "atheism" })),
    ...aqeedahBooks.map((b) => ({ ...b, category: "aqeedah" })),
    ...adyanBooks.map((b) => ({ ...b, category: "adyan" })),
    ...maqabehBooks.map((b) => ({ ...b, category: "maqabeh" })),
    ...fraqBooks.map((b) => ({ ...b, category: "fraq" })),
    ...daavatBooks.map((b) => ({ ...b, category: "daavat" })),
];

const totalBooks = allBooks.length;
const authorNames = new Set(allBooks.map((b) => normalizeAuthor(b.data.author)));
const totalAuthors = authorNames.size;
const shiiteCount = shiiteBooks.length;
const atheismCount = atheismBooks.length;
const aqeedahCount = aqeedahBooks.length;
const adyanCount = adyanBooks.length;
const maqabehCount = maqabehBooks.length;
const fraqCount = fraqBooks.length;
const daavatCount = daavatBooks.length;

const newest = [...allBooks].sort((a, b) => {
    const ta = a.data.pubDate || (a.filePath ? statSync(a.filePath).mtime : 0);
    const tb = b.data.pubDate || (b.filePath ? statSync(b.filePath).mtime : 0);
    return new Date(tb) - new Date(ta);
}).slice(0, 5);
const mostRead = [...allBooks].sort((a, b) => (b.data.reads || 0) - (a.data.reads || 0)).slice(0, 5);

const categoryDefs = [
    { key: "shiite", label: "شیعه" },
    { key: "atheism", label: "الحاد" },
    { key: "aqeedah", label: "عقیده" },
    { key: "adyan", label: "ادیان" },
    { key: "maqabeh", label: "مکاتب فکری" },
    { key: "fraq", label: "فرقه‌ها" },
    { key: "daavat", label: "دعوت" },
];

const escHtml = (s) =>
    String(s ?? "").replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;");

const bookTime = (b) => {
    if (b.data.pubDate) return new Date(b.data.pubDate).getTime();
    return b.filePath ? statSync(b.filePath).mtimeMs : 0;
};

const todayQueues = categoryDefs
    .map((c) => ({
        key: c.key,
        label: c.label,
        books: allBooks
            .filter((b) => b.category === c.key && b.data.today)
            .sort((a, b) => bookTime(a) - bookTime(b)),
    }))
    .filter((c) => c.books.length > 0);

const catLabel = (key) => (categoryDefs.find((c) => c.key === key) || {}).label || key;

const todayPanels = todayQueues.map((c) =>
    c.books.map((b) => {
        const desc = b.data.caption || b.data.description;
        const cover = b.data.cover
            ? `<img class="cover-img" src="${escHtml(b.data.cover)}" alt="${escHtml(b.data.title)}">`
            : `<div class="cover-photo ${b.category}"><div class="cover-inner"><span class="cover-cat">${escHtml(c.label)}</span><h2>${escHtml(b.data.title)}</h2><div class="cover-footer"><span class="cover-author">مترجم: ${escHtml(b.data.author)}</span></div></div></div>`;
        return `<a class="today-link" href="/books/${slugify(b.data.title)}"><div class="today-info"><h2>${escHtml(b.data.title)}</h2><p class="today-author">${escHtml(b.data.author)}</p>${desc ? `<p class="today-desc">${escHtml(desc)}</p>` : ""}<div class="today-actions"><span class="today-cta">مشاهده کتاب</span></div></div>${cover}</a>`;
    })
);
---

<MainLayout>

<section class="hero">

    <div class="hero-text">
        <img class="site-logo logo-light" src="/icons/Light.svg" alt="کتاب‌شناسی" />
        <img class="site-logo logo-dark" src="/icons/Dark.svg" alt="کتاب‌شناسی" />
    </div>

    <div class="hero-description">
        <p class="hero-desc-desktop"><strong>مرجعی تخصصی</strong> برای معرفی و دسترسی به کتاب‌ها و منابع ارزشمند در حوزه اسلام، ادیان و مکاتب فکری است؛ بستری برای آن‌که پژوهشگران، دانشجویان و علاقه‌مندان بتوانند در میان آثار و منابع معتبر، به‌ویژه کتاب‌های اهل سنت، مسیر مطالعه و پژوهش خود را آگاهانه‌تر و آسان‌تر پیدا کنند و هر کتاب، دریچه‌ای باشد به سوی دانشی تازه و نگاهی عمیق‌تر.</p>
        <p class="hero-desc-mobile"><strong>مرجعی تخصصی</strong> برای معرفی کتاب‌ها و منابع معتبر در حوزه اسلام، ادیان و مکاتب فکری؛ با هدف آسان‌تر کردن مسیر مطالعه، پژوهش و دسترسی به منابع ارزشمند آثار اهل سنت.</p>
    </div>

    <div class="hero-library">
        <img class="lib-light" src="/icons/library-light.svg" alt="کتابخانه" />
        <img class="lib-dark" src="/icons/library-dark.svg" alt="کتابخانه" />
    </div>

</section>

<section class="widgets">

{
    todayQueues.length > 0 && (
        <div class="card today-card" data-today-card>

            <h3>کتاب پیشنهادی</h3>

            <div
                class="today-panel"
                data-today-panel
                set:html={todayPanels[0][0]}
            />

        </div>
    )
}

{
    todayQueues.length > 0 && (
        <script
            type="application/json"
            id="today-queue"
            set:html={JSON.stringify({ count: todayQueues.length, panels: todayPanels })}
        />
    )
}

    <div class="card">

        <h3>تازه‌های سایت</h3>

        <div class="card-list">
            {
                newest.map((b) => (
                    <a class="card-link" href={`/books/${slugify(b.data.title)}`}>
                        {b.data.title}
                    </a>
                ))
            }
        </div>

    </div>

    <div class="card">

        <h3>پرخواننده‌ترین</h3>

        <div class="card-list">
            {
                mostRead.map((b, i) => (
                    <a class="card-link ranked" href={`/books/${slugify(b.data.title)}`}>
                        <span class="rank">{[ "۰۱", "۰۲", "۰۳", "۰۴", "۰۵" ][i]}</span>
                        <span>{b.data.title}</span>
                    </a>
                ))
            }
        </div>

    </div>

</section>

<section class="stats-row">

    <div class="card stat">
        <h3>کل کتاب‌ها</h3>
        <strong>{toPersian(totalBooks)}</strong>
    </div>

    <div class="card stat">
        <h3>نویسندگان</h3>
        <strong>{toPersian(totalAuthors)}</strong>
    </div>

    <div class="card stat">
        <h3>کتاب شیعه</h3>
        <strong>{toPersian(shiiteCount)}</strong>
    </div>

    <div class="card stat">
        <h3>کتاب الحاد</h3>
        <strong>{toPersian(atheismCount)}</strong>
    </div>

</section>

</MainLayout>

<script>
const initToday = () => {
const todayCard = document.querySelector("[data-today-card]");
if (!todayCard || todayCard.dataset.bound) return;
todayCard.dataset.bound = "1";
const queueEl = document.getElementById("today-queue");
if (!queueEl) return;
const queue = JSON.parse(queueEl.textContent);
const panel = todayCard.querySelector("[data-today-panel]");
const render = () => {
if (!panel) return;
const now = new Date();
const localDay = Math.floor(Date.UTC(now.getFullYear(), now.getMonth(), now.getDate()) / 86400000);
const catIdx = localDay % queue.count;
const cycle = Math.floor(localDay / queue.count);
const list = queue.panels[catIdx];
if (Array.isArray(list) && list.length) {
panel.innerHTML = list[cycle % list.length];
}
};
render();
const now = new Date();
const nextMidnight = new Date(now.getFullYear(), now.getMonth(), now.getDate() + 1);
setTimeout(render, nextMidnight - now);
};
initToday();
document.addEventListener("astro:page-load", initToday);
</script>

<style lang="scss">

@font-face{
font-family:"Adobe Arabic";
src:url("/fonts/Adobe arabic shin.woff2") format("woff2");
font-weight:700;
font-style:normal;
font-display:swap;
}

@font-face{
font-family:"Alexandria";
src:url("/fonts/Alexandria-Regular.woff2") format("woff2");
font-weight:400;
font-style:normal;
font-display:swap;
}

@font-face{
font-family:"Alexandria";
src:url("/fonts/Alexandria-Bold.woff2") format("woff2");
font-weight:700;
font-style:normal;
font-display:swap;
}

.hero{
display:flex;
flex-direction:row;
justify-content:flex-start;
align-items:center;
gap:20px;
padding:10px 0;
box-sizing:border-box;
}

.hero-text{
position:relative;
width:min(250px,80%);
aspect-ratio:432/323;
}

.site-logo{
display:block;
width:100%;
height:auto;
position:absolute;
inset:0;
margin:auto;
transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

.logo-light{
opacity:1;
transform:scale(1);
}

.logo-dark{
opacity:0;
transform:scale(.9);
}

:global(.dark) .logo-light{
opacity:0;
transform:scale(.9);
}

:global(.dark) .logo-dark{
opacity:1;
transform:scale(1);
}

@media(max-width:900px){
.hero{
height:auto;
min-height:0;
padding:8px 0;
}

.hero-text{
width:min(45vw,170px);
}
}

.hero-description{
flex:1;
max-width:30%;
align-self:center;
text-align:justify;
direction:rtl;
font-size:17px;
line-height:1.9;
color:var(--gray);

.hero-desc-mobile{
display:none;
}

p{
margin:0;
}
}

.hero-text{
    flex-shrink:0;
}

.hero-library{
    flex-shrink:0;
    width:min(360px,30%);
    aspect-ratio:4/3;
    position:relative;
}

.hero-library img{
    display:block;
    width:100%;
    height:100%;
    position:absolute;
    inset:0;
    margin:auto;
    transition:opacity .6s cubic-bezier(.4,0,.2,1), transform .6s cubic-bezier(.4,0,.2,1);
}

.lib-light{
    opacity:1;
    transform:scale(1);
}

.lib-dark{
    opacity:0;
    transform:scale(.9);
}

:global(.dark) .lib-light{
    opacity:0;
    transform:scale(.9);
}

:global(.dark) .lib-dark{
    opacity:1;
    transform:scale(1);
}

@media(max-width:900px){
    .hero{
        gap:16px;
    }

    .hero-description{
        text-align:justify;
        font-size:14px;
        max-width:none;
        margin:7px 10px;
        padding:0 6px;

        .hero-desc-desktop{
            display:none;
        }

        .hero-desc-mobile{
            display:block;
        }
    }

    .hero-library{
        display:none;
    }
}

.widgets{
display:grid;
grid-template-columns:repeat(12,1fr);
gap:16px;
}

.widgets .card{
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:25px;
grid-column:span 4;
transition:transform .3s ease, box-shadow .3s ease, background .6s ease, border-color .6s ease;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
margin-bottom:20px;
background:color-mix(in srgb, var(--accent) 14%, transparent);
color:var(--text);
padding:8px 14px;
border-radius:12px;
border:1px solid color-mix(in srgb, var(--accent) 22%, transparent);
font-size:14px;
font-weight:700;
}
}

.card-list{
display:flex;
flex-direction:column;
}

.card-link{
display:block;
color:var(--text);
text-decoration:none;
padding:11px 4px;
font-size:14px;
transition:color .2s, background .2s ease;
border-radius:10px;

&:not(:last-child){
border-bottom:1px dashed var(--border);
}

&:hover{
color:var(--accent);
background:color-mix(in srgb, var(--accent) 6%, transparent);
}

&.ranked{
display:flex;
align-items:center;
gap:12px;

.rank{
flex-shrink:0;
font-size:12px;
font-weight:700;
color:var(--accent);
background:color-mix(in srgb, var(--accent) 14%, transparent);
min-width:34px;
text-align:center;
padding:3px 6px;
border-radius:8px;
}
}
}

.today-card{
display:flex;
flex-direction:column;
overflow:hidden;

.today-panel{
display:block;
}
}

.stats-row{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:16px;
margin-top:15px;
}

.stats-row .card{
background:var(--card);
border:1px solid var(--border);
border-radius:22px;
padding:25px;
text-align:center;

&:hover{
transform:translateY(-4px);
box-shadow:0 10px 30px color-mix(in srgb, var(--accent) 12%, transparent);
}

h3{
background:transparent;
border:none;
padding:0;
border-radius:0;
font-size:13px;
margin-bottom:10px;
color:var(--text);
}

strong{
font-size:40px;
color:var(--accent);
}
}

@media(max-width:900px){
.widgets{
grid-template-columns:1fr;

.card{
grid-column:span 1;
}
}

.stats-row{
grid-template-columns:repeat(4,1fr);
gap:8px;

.card{
padding:15px;

strong{
font-size:20px;
}

h3{
font-size:10px;
}
}
}
}

</style>

<style is:global lang="scss">

.today-link{
position:relative;
z-index:2;
background:var(--card);
display:flex;
gap:22px;
text-decoration:none;
align-items:stretch;
flex:1;

.cover-photo,
.cover-img{
width:130px;
flex-shrink:0;
order:2;
align-self:flex-start;
}

.today-info{
flex:1;
min-width:0;
display:flex;
flex-direction:column;
order:1;

h2{
font-size:20px;
font-weight:800;
color:var(--text);
line-height:1.6;
margin-bottom:6px;
}

.today-author{
color:var(--accent);
font-size:13px;
font-weight:600;
margin:0 0 10px;
}

.today-desc{
flex:1;
color:var(--gray);
font-size:13px;
line-height:1.9;
margin:0 0 14px;
text-align:justify;
}

.today-actions{
display:flex;
align-items:center;
gap:14px;
margin-top:auto;
}

.today-cta{
display:inline-block;
background:var(--accent);
color:#fff;
font-size:13px;
font-weight:700;
padding:8px 22px;
border-radius:20px;
transition:transform .2s ease, box-shadow .2s ease;
}
}
}

.cover-img{
width:100%;
border-radius:14px;
box-shadow:0 20px 40px rgba(0,0,0,.2);
}

.cover-photo{
aspect-ratio:2/3;
border-radius:14px;
padding:10px;
box-shadow:0 20px 40px rgba(0,0,0,.22);
transition:transform .4s ease;

&.shiite{ background:linear-gradient(160deg,#1D6A96,#0d3b58); }
&.atheism{ background:linear-gradient(160deg,#2b2f36,#101318); }
&.aqeedah{ background:linear-gradient(160deg,#6b4f1d,#3a2a0d); }
&.adyan{ background:linear-gradient(160deg,#4a5d3a,#23301c); }
&.maqabeh{ background:linear-gradient(160deg,#5b3a6b,#2c1a36); }
&.fraq{ background:linear-gradient(160deg,#6b1d3a,#380d1e); }
&.daavat{ background:linear-gradient(160deg,#1d6b55,#0d382c); }

.cover-inner{
height:100%;
border:1px solid rgba(255,255,255,.25);
border-radius:8px;
padding:18px;
display:flex;
flex-direction:column;
align-items:center;
justify-content:space-between;
text-align:center;
color:#fff;
overflow:hidden;
position:relative;
}

.cover-cat{
font-size:11px;
letter-spacing:.5px;
opacity:.85;
background:rgba(255,255,255,.15);
padding:5px 12px;
border-radius:20px;
}

.cover-inner h2{
font-size:17px;
font-weight:700;
line-height:1.6;
padding:0 6px;
}

.cover-footer{
width:100%;

.cover-author{
display:block;
font-size:12px;
opacity:.9;
border-top:1px solid rgba(255,255,255,.3);
padding-top:10px;
}
}
}

@media(max-width:900px){
.today-link{
gap:14px;

.cover-photo,
.cover-img{
width:100px;
}
}
}

</style>
