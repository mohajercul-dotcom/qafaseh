---
import MainLayout from "../layouts/MainLayout.astro";
import BookCard from "../components/BookCard.astro";
import { getCollection } from "astro:content";
import { slugify } from "../lib/books.js";

const books = (await getCollection("atheism")).sort((a, b) =>
    a.data.title.localeCompare(b.data.title, "fa")
);
---

<MainLayout>

<section class="page-hero">

    <h1>کتاب‌های الحاد</h1>

    <p>کتاب‌هایی درباره خداناباوری، نقد دین و اندیشه‌های الحادی.</p>

</section>

<div class="books" id="books-atheism" data-cols="3">
    {books.map((book) => (
        <div class="book-item">
            <BookCard
                title={book.data.title}
                author={book.data.author}
                description={book.data.description}
                publisher={book.data.publisher}
                year={book.data.year}
                language={book.data.language}
                href={`/books/${slugify(book.data.title)}`}
            />
        </div>
    ))}
</div>

<script>
import { initAllGrids } from "../lib/bookGrid.js";
initAllGrids();
window.addEventListener("resize", initAllGrids);
</script>

</MainLayout>

<style lang="scss">

.page-hero{
padding:40px 0;
text-align:center;

h1{
font-size:40px;
font-weight:900;
}

p{
margin-top:12px;
color:var(--gray);
}
}

.books{
display:flex;
gap:16px;
padding:20px 0 40px;
}

:global(.book-col){
flex:1;
display:flex;
flex-direction:column;
gap:16px;
}

@media(max-width:900px){
.books{
flex-direction:column;
}
}

</style>
